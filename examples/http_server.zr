include "http.zr"

func main[] : i64
    io.println("Starting HTTP server on :8000...")
    http.start_single_threaded_server("0.0.0.0", 8000, ^handler)

func handler[r: http.Req, w: http.Resp] : void
    real_path := "."->concat(r->path) // TODO: validate
    defer real_path->free()
    content, err := io.read_file(real_path)->unpack()
    if err as ptr
        w->status = 404
        return

    w->body = content
