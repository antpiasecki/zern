include "io.zr"

func main[] : i64
    // https://brainfuck.org/sierpinski.b
    src := "++++++++[>+>++++<<-]>++>>+<[-[>>+<<-]+>>]>+[-<<<[->[+[-]+>++>>>-<<]<[<]>>++++++[<<+++++>>-]+<<++.[-]<<]>.>+[>>]>+]"
    i := 0

    memory := Bytes.alloc_zeroed(30000)
    defer memory->free()
    p := 0

    while i < src->len
        op := src[i]

        if op == '>'
            p += 1
        else if op == '<'
            p -= 1
        else if op == '+'
            memory[p] += 1
        else if op == '-'
            memory[p] -= 1
        else if op == '.'
            io.print_char(memory[p])
        else if op == ','
            io.read(STDIN_FILENO, memory->raw_ptr()@[p], 1)
        else if op == '['
            if !memory[p]
                i += 1
                opened := 0
                while i < src->len && !(src[i] == ']' && !opened)
                    if src[i] == '['
                        opened += 1
                    else if src[i] == ']'
                        opened -= 1
                    i += 1
        else if op == ']'
            if memory[p]
                i -= 1
                closed := 0
                while i >= 0 && !(src[i] == '[' && !closed)
                    if src[i] == ']'
                        closed += 1
                    else if src[i] == '['
                        closed -= 1
                    i -= 1

        i += 1
