include "http.zr"

func main[argc: i64, argv: ptr] : i64
    args := os.args(argc, argv)
    if args->len < 2
        io.println("Usage: fetch <url>")
        return 1
    url := args->nth(1)
    resp, err := http.get(url)
    if err io.panic_with("request failed", err)
    defer resp->free()

    io.print_n(resp->raw_ptr(), resp->len)
