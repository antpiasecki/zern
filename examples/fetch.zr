include "http.zr"

func main[argc: i64, argv: ptr] : i64
    if argc < 2
        io.println("Usage: fetch <url>")
        return 1

    url := os.arg(argv, 1)
    resp, err := http.get(url)
    if err io.panic_with("request failed", err)
    defer resp->free()

    io.print_n(resp->get_raw_unchecked_pointer(), resp->len)
