include "$/io.zr"
include "$/net.zr"

func main[] : i64
    s, ok := net.create_udp_server("127.0.0.1", 8000)
    if !ok
        io.panic("net.create_udp_server failed")

    io.println("Listening on port 8000...")
    while true
        data, sa := s->receive(IP_MAXPACKET)
        handle_pkt(s, data, sa)

func handle_pkt[s: net.UDPSocket, data: Buffer, sa: ptr] : void
    defer data->free()
    defer sa->free()

    if data->size <= 0
        return

    io.printf("%s:%d\n", net.ipv4_to_string(sa + 4), mem.read16be(sa + 2))

    io.print_n(data->data(), data->size)
    io.println("")

    s->send_to(sa, data->data(), data->size)
