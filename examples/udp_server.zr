include "$/io.zr"
include "$/net.zr"

func main[] : i64
    s, ok := net.create_udp_server("127.0.0.1", 8000)
    if !ok
        io.panic("net.create_udp_server failed")

    io.println("Listening on port 8000...")
    while true
        data, sa := s->receive(IP_MAXPACKET)
        if data->size <= 0
            data->free()
            continue

        io.printf("%d.%d.%d.%d:%d\n", sa[4], sa[5], sa[6], sa[7], mem.read16be(sa + 2))

        io.print_n(data->data(), data->size)
        io.println("")

        s->send_to(sa, data->data(), data->size)
        data->free()
        sa->free()
