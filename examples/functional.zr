include "io.zr"

func square_and_reverse[x: i64] : str
    tmp := (x * x)->to_str()
    defer tmp->free()
    return tmp->reverse()

func main[] : i64
    numbers := [1, 2, 3, 4, 5, 6, 7] as Array<i64>
    out := Array.map::<i64, str>(^square_and_reverse, numbers)
    for i in 0..out->len
        io.println(out->nth(i))
