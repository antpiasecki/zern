// needs to be compiled with -m -C "-lraylib"
include "$/io.zr"

extern InitWindow[width: i64, height: i64, title: str] : void
extern SetTargetFPS[fps: i64] : void
extern WindowShouldClose[] : bool
extern BeginDrawing[] : void
extern EndDrawing[] : void
extern ClearBackground[color: i64] : void
extern CloseWindow[] : void
extern DrawRectangle[posX: i64, posY: i64, width: i64, height: i64, color: i64] : void
extern IsKeyDown[key: i64] : bool

const KEY_W = 87
const KEY_S = 83
const KEY_A = 65
const KEY_D = 68

const WHITE = 0xffffffff
const RED = 0xff0000ff

func main[] : i64
    x := 200
    y := 200

    InitWindow(800, 600, "Hello, World!")
    SetTargetFPS(60)

    while !(WindowShouldClose() as bool)
        if IsKeyDown(KEY_W) as u8 & 255
            y -= 10
        if IsKeyDown(KEY_S) as u8 & 255
            y += 10
        if IsKeyDown(KEY_A) as u8 & 255
            x -= 10
        if IsKeyDown(KEY_D) as u8 & 255
            x += 10

        BeginDrawing()
        ClearBackground(WHITE)
        DrawRectangle(x, y, 100, 100, RED)
        EndDrawing()

    CloseWindow()
