include "$/io.zr"
include "$/containers.zr"

func rule110_step[state: Array::<bool>] : void
    new_state := [] as Array::<bool>
    defer new_state->free::<bool>()

    for i in 0..state->len
        left := false
        if i - 1 >= 0
            left = state->nth::<bool>(i - 1)
        center := state->nth::<bool>(i)
        right := false
        if i + 1 < state->len
            right = state->nth::<bool>(i + 1)

        new_state->push::<bool>(!((!left && !center && !right) || (left && !center && !right) || (left && center && right)))

    mem.copy_n(new_state->data, state->data, state->len * 8)

func print_state[state: Array::<bool>]: void
    for i in 0..state->len
        if state->nth::<bool>(i)
            io.print_char('#')
        else
            io.print_char(' ')
    io.println("")

func main[] : i64
    SIZE := 60

    state := [] as Array::<bool>
    defer state->free::<bool>()
    for i in 0..SIZE
        state->push::<bool>(false)
    state->push::<bool>(true)

    print_state(state)
    for i in 0..SIZE
        rule110_step(state)
        print_state(state)
