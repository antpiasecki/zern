include "containers.zr"

const SIZE = 60

func main[] : i64
    state := _stackalloc(SIZE)
    mem.zero(state, SIZE)
    state[SIZE-1] = 1

    print_state(state)
    for i in 0..SIZE-1
        rule110_step(state)
        print_state(state)

func rule110_step[state: ptr] : void
    left := false
    for i in 0..SIZE
        center := state[i] as bool
        right := false
        if i + 1 < SIZE
            right = state[i+1] as bool

        state[i] = ((center || right) && !(left && center && right)) as u8
        left = center

func print_state[state: ptr]: void
    s := str.alloc(SIZE)
    defer s->free()
    for i in 0..SIZE
        if state[i]
            s[i] = '#'
        else
            s[i] = ' '
    io.println(s)
