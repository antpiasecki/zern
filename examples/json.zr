include "$/json.zr"

func main[] : i64
    v := json.parse("{\"apples\": 3, \"names\": [\"Alice\", \"Bob\"]}")
    defer v->free()

    io.println(v->dump())

    map := v->get$<HashMap>()
    names_val, ok := map->get$<json.Value>("names")
    names := names_val->get$<Array>()
    for i in 0..names->len
        io.println(names->nth$<json.Value>(i)->get$<str>())
