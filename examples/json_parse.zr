include "json.zr"

func main[] : i64
    v, err := json.parse("{\"apples\": 3, \"names\": [\"Alice\", \"Bob\"]}")
    if err io.panic_with("failed to parse", err)
    defer v->free()

    io.println(v->dump())

    names, err := v->object()->get("names")
    if err io.panic("names not found")
    names_arr := names->array()
    for i in 0..names_arr->len
        io.println(names_arr->nth(i)->str())
