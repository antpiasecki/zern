include "json.zr"

func main[] : i64
    v := json.parse("{\"apples\": 3, \"names\": [\"Alice\", \"Bob\"]}")->expect("failed to parse")
    defer v->free()

    io.println(v->dump())

    names_val, ok := v->object()->get("names")
    names := names_val->array()
    for i in 0..names->len
        io.println(names->nth(i)->str())
