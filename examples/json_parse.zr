include "json.zr"

func main[] : i64
    v := json.parse("{\"apples\": 3, \"names\": [\"Alice\", \"Bob\"]}")->expect("failed to parse")
    defer v->free()

    io.println(v->dump())

    names := v->object()->get("names")->expect("names not found")->array()
    for i in 0..names->len
        io.println(names->nth(i)->str())
