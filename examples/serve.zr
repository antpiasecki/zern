// needs to be compiled with -m -C "-lpthread"
include "$/net.zr"

func pthread_create[thread: ptr, attr: ptr, start_routine: ptr, arg: ptr] : i64 @[extern]
func pthread_detach[thread: i64] : i64 @[extern]

struct ConnData
    sock: i64
    addr: str

func handle_connection[conn: ConnData] : void
    defer
        net.close(conn->sock)
        conn->addr->free()
        (conn as ptr)->free()

    req := _stackalloc(10001) as str
    n := net.read(conn->sock, req as ptr, 10000)
    if n <= 0
        return

    req[n] = 0

    pos := req->find("\r\n")
    if pos == -1
        return

    first_line := req->substr_n(0, pos)
    defer first_line->free()
    parts := first_line->split(" ")
    defer parts->free_with_items()
    method := parts->nth$<str>(0)
    path := parts->nth$<str>(1)

    if !method->equal("GET")
        resp := "HTTP/1.1 405 Method Not Allowed\r\nConnection: close\r\n\r\n405 Method Not Allowed"
        net.send(conn->sock, resp as ptr, resp->len())
        return

    if path->contains("..") || path->find("/") != 0
        resp := "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n400 Bad Request"
        net.send(conn->sock, resp as ptr, resp->len())
        return

    file_path := "."->concat(path)
    defer file_path->free()

    if os.is_a_directory(file_path)
        b := new str.Builder
        b->append("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nConnection: close\r\n\r\n<ul>\n")
        files, ok := os.list_directory(file_path)
        if !ok
            resp := "HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\n404 Not Found"
            net.send(conn->sock, resp as ptr, resp->len())
            return
        line := _stackalloc(4096) as str
        for i in 0..files->len
            line->format_into(4096, "<li><a href=\"%s/%s\">%s</a></li>\n", path@[1], files->nth$<str>(i), files->nth$<str>(i))
            b->append(line)
        b->append("</ul>")
        resp := b->build_str_and_free_inner()
        defer resp->free()
        net.send(conn->sock, resp as ptr, resp->len())
        return

    file_size, ok := os.get_file_size(file_path)
    if !ok
        resp := "HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\n404 Not Found"
        net.send(conn->sock, resp as ptr, resp->len())
        return

    fd, ok := io.open_for_reading(file_path)
    if !ok
        resp := "HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\n404 Not Found"
        net.send(conn->sock, resp as ptr, resp->len())
        return
    defer io.close(fd)

    resp := "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n"
    net.send(conn->sock, resp as ptr, resp->len())

    offset := 0
    while offset < file_size
        sent := io.send_file(conn->sock, fd, ^offset, IP_MAXPACKET)
        if sent <= 0
            break

func main[argc: i64, argv: ptr] : i64
    port := 8000

    if argc > 1
        port = os.arg(argv, 1)->parse_i64()

    server_sock, ok := net.listen("0.0.0.0", port)
    if !ok
        io.panic("failed to listen")

    io.printf("Listening on :%d...\n", port)

    addr := _stackalloc(16)
    while true
        conn := net.accept(server_sock, addr)
        if conn < 0
            io.println("ERROR: failed to accept connection")
            continue

        conn_data := new* ConnData
        conn_data->sock = conn
        conn_data->addr = mem.alloc(30) as str
        conn_data->addr->format_into(30, "%d.%d.%d.%d:%d", addr[4], addr[5], addr[6], addr[7], mem.read16be(addr@[2]))

        thread := 0
        pthread_create(^thread, 0 as ptr, ^handle_connection, conn_data as ptr)
        pthread_detach(thread)
