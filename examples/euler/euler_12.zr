include "io.zr"

func num_divisors[n: i64] : i64
    k := n
    out := 1
    i := 2

    while i * i <= k
        e := 0
        while k % i == 0
            k = k / i
            e += 1
        out = out * (e + 1)
        i += 1

    if k > 1
        out = out * 2
    return out

func main[] : i64
    n := 0
    i := 1
    while true
        n += i
        if num_divisors(n) > 500
            io.println_i64(n)
            break
        i += 1
