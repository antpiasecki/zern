include "io.zr"

func divisors_sum[n: i64] : i64
    k := n
    sum := 1
    i := 2

    while i * i <= k
        if k % i == 0
            term := 1
            p := 1
            while k % i == 0
                p = p * i
                term = term + p
                k = k / i
            sum = sum * term
        i += 1

    if k > 1
        sum = sum * (k + 1)

    return sum - n

func main[] : i64
    sum := 0

    for i in 2..10000
        d := divisors_sum(i)
        if i < d && i == divisors_sum(d)
            sum += i + d

    io.println_i64(sum)
