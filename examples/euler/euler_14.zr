include "io.zr"

func collatz_num[n: i64] : i64
    if n % 2 == 0
        return n / 2
    return n * 3 + 1

func main[] : i64
    cache := [] as Array<i64>
    cache->preallocate_and_zero(1000000)
    cache->set(1, 1)
    best_len := 0
    best_start := 0

    for i in 2..1000000
        n := i
        steps := 0
        while n >= i
            n = collatz_num(n)
            steps += 1
        cache->set(i, steps + cache->nth(n))
        if cache->nth(i) > best_len
            best_len = cache->nth(i)
            best_start = i
    io.println_i64(best_start)
