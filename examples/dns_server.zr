// port of https://git.ton1.dev/toni/dns-server
include "containers.zr"
include "net.zr"

const TTL = 60
const PORT = 10053

func main[] : i64
    records := HashMap.new::<^Bytes>()

    test_su_buffer := Bytes.alloc(4)
    test_su_buffer->write32be(0, net.pack_addr(1, 2, 3, 4))
    records->insert("test.su", test_su_buffer)

    s, err := net.create_udp_server("0.0.0.0", PORT)
    if err io.panic_with("failed to create udp server", err)

    io.printf("Listening on port :%d...\n", PORT)
    while true
        sa := mem.alloc(16)
        data, err := s->receive(sa, 4096)
        if err
            sa->free()
            continue
        resp := handle_req(s, records, data, sa)
        if resp as ptr != 0
            s->send_to(sa, resp->raw_ptr(), resp->len)
            resp->free()

func handle_req[s: ^net.UDPSocket, records: ^HashMap<^Bytes>, req: ^Bytes, sa: ptr] : ^Bytes
    defer req->free()
    defer sa->free()

    if req->len <= 12
        return 0 as ^Bytes

    // we assume that QDCOUNT=1 but i think that's reasonable

    // https://datatracker.ietf.org/doc/html/rfc1035#section-4.1.2
    labels := new str.Builder
    defer labels->free_inner()
    offset := 12
    while true
        if offset >= req->len
            return 0 as ^Bytes
        length := req[offset] as i64
        offset += 1
        if length == 0
            break
        if length > 63 || offset + length > req->len
            return 0 as ^Bytes
        labels->append_n(req->raw_ptr()@[offset], length)
        labels->append_char('.')
        offset += length
    if offset > req->len
        return 0 as ^Bytes

    raw_name_len := offset-12
    name := labels->build_str_and_free_inner()
    defer name->free()

    name_lower := name->to_lower()
    defer name_lower->free()
    name_lower[name_lower->len-1] = 0 // remove extra dot

    if offset+4 > req->len
        return 0 as ^Bytes
    // https://datatracker.ietf.org/doc/html/rfc1035#section-3.2.2
    question_type := req->read16be(offset)
    offset += 2
    // https://datatracker.ietf.org/doc/html/rfc1035#section-3.2.4
    question_class := req->read16be(offset)
    offset += 2

    io.printf("CLIENT=%s QNAME=%s TYPE=%d CLASS=%d\n", net.ipv4_to_string(sa@[4]), name_lower, question_type, question_class)

    nxdomain := false
    rdata := 0 as ptr
    rdata_len := 0
    record, err := records->get(name_lower)
    if question_class == DNS_CLASS_IN && !err
        if question_type == DNS_TYPE_A && record->len == 4
            rdata = record->raw_ptr()
            rdata_len = record->len
        else if question_type == DNS_TYPE_AAAA && record->len == 16
            rdata = record->raw_ptr()
            rdata_len = record->len
    else
        nxdomain = true

    resp_len := offset + raw_name_len + 10 + rdata_len
    resp := Bytes.alloc_zeroed(resp_len)
    resp->copy_into(req->raw_ptr(), 0, offset)

    resp[3] = resp[3] & 0xf0 // clear RCODE
    if nxdomain
        resp[3] = resp[3] | 0x03 // RCODE=NXDOMAIN
    resp[2] = resp[2] | 0x80 // QR=1 (response)
    resp[2] = resp[2] | 0x04 // authoritative answer
    resp[3] = resp[3] & 0x7f // recursion not available

    resp->write16be(6, 0)  // ANCOUNT = 0
    resp->write16be(8, 0)  // NSCOUNT = 0
    resp->write16be(10, 0) // ARCOUNT = 0

    if rdata
        // https://datatracker.ietf.org/doc/html/rfc1035#section-4.1.3
        resp->copy_into(req->raw_ptr()@[12], offset, raw_name_len)
        offset += raw_name_len
        resp->write16be(offset, question_type)
        resp->write16be(offset+2, question_class)
        resp->write32be(offset+4, TTL)
        resp->write16be(offset+8, rdata_len)
        resp->copy_into(rdata, offset+10, rdata_len)

        resp->write16be(6, 1) // ANCOUNT=1

    return resp
