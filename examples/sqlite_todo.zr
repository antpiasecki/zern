// needs to be compiled with -m -C "-lsqlite3"
include "$/io.zr"

extern sqlite3_open[filename: str, ppDb: ptr] : i64
extern sqlite3_exec[db: i64, sql: str, callback: i64, arg: i64, errmsg: i64] : i64
extern sqlite3_prepare_v2[db: i64, zSql: str, nByte: i64, ppStmt: ptr, pzTail: i64] : i64
extern sqlite3_bind_int[stmt: i64, index: i64, value: i64] : i64
extern sqlite3_bind_text[stmt: i64, index: i64, value: str, n: i64, destructor: i64] : i64
extern sqlite3_step[stmt: i64] : i64
extern sqlite3_errmsg[db: i64] : str
extern sqlite3_column_int[stmt: i64, iCol: i64] : i64
extern sqlite3_column_text[stmt: i64, iCol: i64] : str
extern sqlite3_finalize[stmt: i64] : i64

const SQLITE_ROW  = 100
const SQLITE_DONE = 101

func main[] : i64
    rc := 0
    db := 0
    stmt := 0

    rc = sqlite3_open("todo.db", ^db) as i64
    if rc
        io.panic("failed to open db")

    rc = sqlite3_exec(db, "CREATE TABLE IF NOT EXISTS todo(id INTEGER PRIMARY KEY AUTOINCREMENT, task TEXT NOT NULL);", 0, 0, 0) as i64
    if rc
        io.panic(sqlite3_errmsg(db) as str)

    while true
        io.println("1. List tasks")
        io.println("2. Add task")
        io.println("3. Delete task")
        io.println("0. Quit")
        io.print("\n> ")

        choice := io.read_line()->parse_i64()

        if choice == 0
            break
        else if choice == 1
            io.println("============")
            sqlite3_prepare_v2(db, "SELECT * FROM todo", -1, ^stmt, 0)

            while sqlite3_step(stmt) as i64 == SQLITE_ROW
                id := sqlite3_column_int(stmt, 0) as i64
                task := sqlite3_column_text(stmt, 1) as str
                io.printf("%d - %s\n", id, task)

            io.println("============")
        else if choice == 2
            io.print("\nEnter new task: ")
            task := io.read_line()->trim()

            sqlite3_prepare_v2(db, "INSERT INTO todo(task) VALUES (?);", -1, ^stmt, 0)
            sqlite3_bind_text(stmt, 1, task, -1, 0)
            if sqlite3_step(stmt) as i64 != SQLITE_DONE
                io.panic(sqlite3_errmsg(db) as str)

            io.println("\nTask added\n")
        else if choice == 3
            io.print("\nEnter task id: ")
            id := io.read_line()->parse_i64()

            sqlite3_prepare_v2(db, "DELETE FROM todo WHERE id = ?;", -1, ^stmt, 0)
            sqlite3_bind_int(stmt, 1, id)
            if sqlite3_step(stmt) as i64 != SQLITE_DONE
                io.panic(sqlite3_errmsg(db) as str)

            io.println("\nTask deleted\n")

    sqlite3_finalize(stmt)
