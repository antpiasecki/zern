// TODO: \uXXXX
include "containers.zr"

const json.OBJECT = 0
const json.ARRAY  = 1
const json.STRING = 2
const json.NUMBER = 3
const json.NULL   = 4
const json.BOOL   = 5

struct json.Value
    type: i64
    value: opaque

func json.Value.dump[v: json.Value] : str
    s := new str.Builder

    if v->type == json.OBJECT
        map := v->value as HashMap<json.Value>
        pairs := map->pairs()
        defer pairs->free_with_ptr_items()
        s->append_char('{')
        for i in 0..pairs->len
            if i > 0
                s->append_char(',')
            s->append_char('"')
            s->append(pairs->nth(i)->a)
            s->append_char('"')
            s->append_char(':')
            d := pairs->nth(i)->b->dump()
            s->append(d)
            d->free()
        s->append_char('}')
    else if v->type == json.ARRAY
        arr := v->value as Array<json.Value>
        s->append_char('[')
        for i in 0..arr->len
            if i > 0
                s->append_char(',')
            d := arr->nth(i)->dump()
            s->append(d)
            d->free()
        s->append_char(']')
    else if v->type == json.STRING
        vs := v->value as str
        s->append_char('"')
        for i in 0..vs->len()
            c := vs[i]
            if c == '"'
                s->append("\\\"")
            else if c == '\\'
                s->append("\\\\")
            else if c == '\n'
                s->append("\\n")
            else if c == '\t'
                s->append("\\t")
            else if c == '\r'
                s->append("\\r")
            else
                s->append_char(c)
        s->append_char('"')
    else if v->type == json.NUMBER
        tmp := _stackalloc(64)
        len := (v->value as f64)->to_str_buf(tmp as str)
        s->append_n(tmp, len)
    else if v->type == json.NULL
        s->append("null")
    else if v->type == json.BOOL
        if v->value as bool
            s->append("true")
        else
            s->append("false")
    else
        io.panic("json.Value.dump: unknown value type")

    return s->build_str_and_free_inner()

func json.Value.free[v: json.Value] : void
    if v->type == json.OBJECT
        map := v->value as HashMap<json.Value>
        defer map->free()
        keys := map->keys()
        for i in 0..keys->len
            value := map->get(keys->nth(i))->expect("unreachable")
            value->free()
        keys->free()
    else if v->type == json.ARRAY
        arr := v->value as Array<json.Value>
        defer arr->free()
        for i in 0..arr->len
            arr->nth(i)->free()
    else if v->type == json.STRING
        (v->value as str)->free()

    (v as ptr)->free()

func json.Value.object[x: json.Value] : HashMap<json.Value>
    if x->type != json.OBJECT
        io.panic("json.Value: object() on non-object")
    return x->value as HashMap<json.Value>
func json.Value.array[x: json.Value] : Array<json.Value>
    if x->type != json.ARRAY
        io.panic("json.Value: array() on non-array")
    return x->value as Array<json.Value>
func json.Value.str[x: json.Value] : str
    if x->type != json.STRING
        io.panic("json.Value: str() on non-str")
    return x->value as str
func json.Value.number[x: json.Value] : f64
    if x->type != json.NUMBER
        io.panic("json.Value: number() on non-number")
    return x->value as f64
func json.Value.bool[x: json.Value] : bool
    if x->type != json.BOOL
        io.panic("json.Value: bool() on non-bool")
    return x->value as bool

func json.new_object[] : json.Value
    v := new* json.Value
    v->type = json.OBJECT
    v->value = HashMap.new::<json.Value>() as opaque
    return v
func json.new_array[] : json.Value
    v := new* json.Value
    v->type = json.ARRAY
    v->value = [] as opaque
    return v
func json.new_str[s: str] : json.Value
    v := new* json.Value
    v->type = json.STRING
    v->value = s as opaque
    return v

func json.parse[s: str] : Result<json.Value>
    p := new json.Parser
    p->s = s
    p->i = 0
    v := try p->_parse_value()
    p->_skip_whitespace()
    if p->_peek() != 0
        v->free()
        return err::<json.Value>("json.parse: trailing garbage")
    return ok::<json.Value>(v)

struct json.Parser
    s: str
    i: i64

func json.Parser._parse_value[p: json.Parser] : Result<json.Value>
    out := new* json.Value
    done := false
    defer
        if !done
            out->free()

    p->_skip_whitespace()

    if p->_peek() == 0
        return err::<json.Value>("json.parse: unexpected EOF")

    if p->_peek() == '{'
        p->i += 1
        p->_skip_whitespace()

        out->type = json.OBJECT
        out->value = HashMap.new::<json.Value>() as opaque

        if p->_peek() != '}'
            while true
                p->_skip_whitespace()
                key := try p->_parse_string()
                p->_skip_whitespace()

                if p->_peek() != ':'
                    key->free()
                    return err::<json.Value>("json.parse: expected ':'")
                p->i += 1
                p->_skip_whitespace()

                value, e := p->_parse_value()->unpack()
                if e as ptr != 0
                    key->free()
                    return err::<json.Value>(e)
                (out->value as HashMap<json.Value>)->insert(key, value)
                key->free()

                p->_skip_whitespace()
                if p->_peek() == ','
                    p->i += 1
                else
                    break

        p->_skip_whitespace()
        if p->_peek() != '}'
            return err::<json.Value>("json.parse: expected '}'")
        p->i += 1
    else if p->_peek() == '['
        p->i += 1
        p->_skip_whitespace()

        out->type = json.ARRAY
        out->value = [] as opaque

        if p->_peek() != ']'
            while true
                p->_skip_whitespace()
                (out->value as Array<json.Value>)->push(try p->_parse_value())
                p->_skip_whitespace()
                if p->_peek() == ','
                    p->i += 1
                else
                    break

        p->_skip_whitespace()
        if p->_peek() != ']'
            return err::<json.Value>("json.parse: expected ']'")
        p->i += 1
    else if p->_peek() == '"'
        s := try p->_parse_string()
        out->type = json.STRING
        out->value = s as opaque
    else if p->_peek()->is_digit() || p->_peek() == '-'
        start := p->i

        if p->_peek() == '-'
            p->i += 1

        while p->_peek()->is_digit()
            p->i += 1
        if p->_peek() == '.'
            p->i += 1
            while p->_peek()->is_digit()
                p->i += 1

        len := p->i - start

        num_str := p->s->substr_n(start, len)
        defer num_str->free()
        out->type = json.NUMBER
        out->value = num_str->parse_f64() as opaque
    else if (p->s@[p->i] as str)->equal_n("null", 4)
        out->type = json.NULL
        p->i += 4
    else if (p->s@[p->i] as str)->equal_n("true", 4)
        out->type = json.BOOL
        out->value = true as opaque
        p->i += 4
    else if (p->s@[p->i] as str)->equal_n("false", 5)
        out->type = json.BOOL
        out->value = false as opaque
        p->i += 5
    else
        return err::<json.Value>("json.parse: unexpected character")

    done = true
    return ok::<json.Value>(out)

func json.Parser._parse_string[p: json.Parser] : Result<str>
    if p->_peek() != '"'
        return err::<str>("json.parse: expected '\"'")
    p->i += 1
    sb := new str.Builder
    defer sb->free_buffer()
    while p->_peek() != '"'
        c := p->_peek()
        if c == 0
            return err::<str>("json.parse: unexpected EOF")
        p->i += 1
        if c == '\\' && p->_peek() != 0
            c = p->_peek()
            p->i += 1
            if c == 'n'
                c = '\n'
            else if c == 't'
                c = '\t'
            else if c == 'r'
                c = '\r'
        sb->append_char(c)
    p->i += 1
    return ok::<str>(sb->build_str_and_free_inner())

func json.Parser._skip_whitespace[p: json.Parser] : void
    while p->_peek()->is_whitespace()
        p->i += 1

func json.Parser._peek[p: json.Parser] : u8
    return p->s[p->i]
