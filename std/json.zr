include "containers.zr"

const json.OBJECT = 0
const json.ARRAY  = 1
const json.STRING = 2
const json.NUMBER = 3
const json.NULL   = 4
const json.BOOL   = 5

struct json.Value
    type: i64
    value: opaque

insta Array.nth$<json.Value>
insta Array.push$<json.Value>
insta HashMap.get$<json.Value>
insta HashMap.insert$<json.Value>

func json.Value.dump[v: json.Value] : str
    s := new str.Builder

    if v->type == json.OBJECT
        map := v->value as HashMap
        keys := map->keys()
        defer keys->free()
        s->append_char('{')
        for i in 0..keys->len
            if i > 0
                s->append_char(',')
            s->append_char('"')
            s->append(keys->nth$<str>(i))
            s->append_char('"')
            s->append_char(':')
            value, _ := map->get$<json.Value>(keys->nth$<str>(i))
            d := value->dump()
            s->append(d)
            d->free()
        s->append_char('}')
    else if v->type == json.ARRAY
        arr := v->value as Array
        s->append_char('[')
        for i in 0..arr->len
            if i > 0
                s->append_char(',')
            d := arr->nth$<json.Value>(i)->dump()
            s->append(d)
            d->free()
        s->append_char(']')
    else if v->type == json.STRING
        // TODO: escape sequences
        s->append_char('"')
        s->append(v->value as str)
        s->append_char('"')
    else if v->type == json.NUMBER
        tmp := _stackalloc(64)
        len := (v->value as f64)->to_str_buf(tmp as str)
        s->append_n(tmp, len)
    else if v->type == json.NULL
        s->append("null")
    else if v->type == json.BOOL
        if v->value as bool
            s->append("true")
        else
            s->append("false")
    else
        io.panic("json.Value.dump: unknown value type")

    return s->build_str_and_free_inner()

func json.Value.free[v: json.Value] : void
    if v->type == json.OBJECT
        map := v->value as HashMap
        defer map->free_with_keys()
        keys := map->keys()
        for i in 0..keys->len
            value, _ := map->get$<json.Value>(keys->nth$<str>(i))
            value->free()
        keys->free()
    else if v->type == json.ARRAY
        arr := v->value as Array
        defer arr->free()
        for i in 0..arr->len
            arr->nth$<json.Value>(i)->free()
    else if v->type == json.STRING
        (v->value as str)->free()

    (v as ptr)->free()

func json.Value.get$<T>[x: json.Value] : T
    return x->value as T

insta json.Value.get$<f64>
insta json.Value.get$<str>
insta json.Value.get$<bool>
insta json.Value.get$<Array>
insta json.Value.get$<HashMap>

func json.parse[s: str] : json.Value
    p := new json.Parser
    p->s = s
    p->i = 0
    return p->_parse_value()

struct json.Parser
    s: str
    i: i64

func json.Parser._parse_value[p: json.Parser] : json.Value
    out := new* json.Value

    p->_skip_whitespace()

    if p->_peek() == 0
        io.panic("json.parse: unexpected EOF")

    if p->_peek() == '{'
        p->i += 1
        p->_skip_whitespace()

        out->type = json.OBJECT
        out->value = HashMap.new() as opaque

        if p->_peek() != '}'
            while true
                p->_skip_whitespace()
                key := p->_parse_string()
                p->_skip_whitespace()

                if p->_peek() != ':'
                    io.panic("json.parse: expected ':'")
                p->i += 1
                p->_skip_whitespace()

                value := p->_parse_value()
                (out->value as HashMap)->insert$<json.Value>(key, value)
                key->free()

                p->_skip_whitespace()
                if p->_peek() == ','
                    p->i += 1
                else
                    break

        p->_skip_whitespace()
        if p->_peek() != '}'
            io.panic("json.parse: expected '}'")
        p->i += 1
    else if p->_peek() == '['
        p->i += 1
        p->_skip_whitespace()

        out->type = json.ARRAY
        out->value = [] as opaque

        while p->_peek() != ']'
            p->_skip_whitespace()

            (out->value as Array)->push$<json.Value>(p->_parse_value())
            p->_skip_whitespace()

            if p->_peek() == ','
                p->i += 1
            else
                break

        p->_skip_whitespace()
        if p->_peek() != ']'
            io.panic("json.parse: expected ']'")
        p->i += 1
    else if p->_peek() == '"'
        out->type = json.STRING
        out->value = p->_parse_string() as opaque
    else if p->_peek()->is_digit() || p->_peek() == '-'
        start := p->i

        if p->_peek() == '-'
            p->i += 1

        while p->_peek()->is_digit()
            p->i += 1
        if p->_peek() == '.'
            p->i += 1
            while p->_peek()->is_digit()
                p->i += 1

        len := p->i - start

        num_str := p->s->substr_n(start, len)
        defer num_str->free()
        out->type = json.NUMBER
        out->value = num_str->parse_f64() as opaque
    else if (p->s@[p->i] as str)->equal_n("null", 4)
        out->type = json.NULL
        p->i += 4
    else if (p->s@[p->i] as str)->equal_n("true", 4)
        out->type = json.BOOL
        out->value = true as opaque
        p->i += 4
    else if (p->s@[p->i] as str)->equal_n("false", 5)
        out->type = json.BOOL
        out->value = false as opaque
        p->i += 5
    else
        io.panic("json.parse: unexpected character")

    return out

func json.Parser._parse_string[p: json.Parser] : str
    if p->_peek() != '"'
        io.panic("json.parse: expected '\"'")
    p->i += 1

    start := p->i
    // TODO: escape sequences
    while p->_peek() != '"'
        if p->_peek() == 0
            io.panic("json.parse: unexpected EOF")
        p->i += 1

    len := p->i - start
    p->i += 1
    return p->s->substr_n(start, len)

func json.Parser._skip_whitespace[p: json.Parser] : void
    while p->_peek()->is_whitespace()
        p->i += 1

func json.Parser._peek[p: json.Parser] : u8
    return p->s[p->i]
