include "os.zr"

const DNS_TYPE_A = 1
const DNS_TYPE_AAAA = 28
const DNS_CLASS_IN = 1
const DNS_RECURSION_DESIRED = 256

var net._dns_server: ^str

func net.listen[host: ^str, port: i64] : i64, err
    packed_host := try net.parse_ipv4_str(host)

    s := builtin.syscall(SYS_socket, AF_INET, SOCK_STREAM, 0)
    if s < 0
        return 0, error("net.listen: socket() failed")

    val := 1
    if builtin.syscall(SYS_setsockopt, s, SOL_SOCKET, SO_REUSEADDR, ^val, 8) < 0
        io.close(s)
        return 0, error("net.listen: setsockopt() failed")

    sa := _stackalloc(16)
    net._build_sa(sa, packed_host, port)

    if builtin.syscall(SYS_bind, s, sa, 16) < 0
        io.close(s)
        return 0, error("net.listen: bind() failed")

    if builtin.syscall(SYS_listen, s, SOMAXCONN) < 0
        io.close(s)
        return 0, error("net.listen: listen() failed")

    return s, ok()

func net.connect[host: ^str, port: i64] : i64, err
    packed_host := try net.resolve(host)

    s := builtin.syscall(SYS_socket, AF_INET, SOCK_STREAM, 0)
    if s < 0
        return 0, error("net.connect: socket() failed")

    sa := _stackalloc(16)
    net._build_sa(sa, packed_host, port)

    if builtin.syscall(SYS_connect, s, sa, 16) < 0
        io.close(s)
        return 0, error("net.connect: connect() failed")

    return s, ok()

func net.accept[s: i64, addr: ptr] : i64
    addrlen := 16
    return builtin.syscall(SYS_accept, s, addr, ^addrlen)

func net.send[s: i64, data: ptr, len: i64] : void
    builtin.syscall(SYS_sendto, s, data, len, 0, 0, 0)

func net.close[s: i64] : void
    io.close(s)

func net.pack_addr[a: i64, b: i64, c: i64, d: i64] : i64
    return (a << 24) | (b << 16) | (c << 8) | d

func net.ipv4_to_string[ip: ptr] : cstr
    out := mem.alloc(50) as cstr
    out->format_into(50, "%d.%d.%d.%d", ip[0], ip[1], ip[2], ip[3])
    return out

func net._build_sa[sa: ptr, packed_host: i64, port: i64] : void
    mem.zero(sa, 16)
    sa[0] = AF_INET
    sa[1] = 0
    sa[2] = (port >> 8) as u8
    sa[3] = port as u8
    sa[4] = (packed_host >> 24) as u8
    sa[5] = (packed_host >> 16) as u8
    sa[6] = (packed_host >> 8) as u8
    sa[7] = packed_host as u8

struct net.UDPSocket
    fd: i64
    addr: ptr

func net.UDPSocket.new_client[host: ^str, port: i64] : ^net.UDPSocket, err
    packed_host := try net.resolve(host)

    s := new* net.UDPSocket
    s->fd = builtin.syscall(SYS_socket, AF_INET, SOCK_DGRAM, 0)
    if s->fd < 0
        (s as ptr)->free()
        return 0 as ^net.UDPSocket, error("net.create_udp_client: socket() failed")

    s->addr = mem.alloc(16)
    net._build_sa(s->addr, packed_host, port)
    return s, ok()

func net.create_udp_server[host: ^str, port: i64] : ^net.UDPSocket, err
    s := try net.UDPSocket.new_client(host, port)

    if builtin.syscall(SYS_bind, s->fd, s->addr, 16) < 0
        s->close_and_free()
        return 0 as ^net.UDPSocket, error("net.create_udp_server: bind() failed")

    return s, ok()

func net.UDPSocket.set_timeout[s: ^net.UDPSocket, ms: i64] : void
    t := new os.Timeval
    t->tv_sec = ms / 1000
    t->tv_usec = (ms % 1000) * 1000
    builtin.syscall(SYS_setsockopt, s->fd, SOL_SOCKET, SO_RCVTIMEO, t, 16)

func net.UDPSocket.send_to[s: ^net.UDPSocket, addr: ptr, data: ptr, len: i64] : void
    builtin.syscall(SYS_sendto, s->fd, data, len, 0, addr, 16)

func net.UDPSocket.receive[s: ^net.UDPSocket, sa_out: ptr, len: i64] : ^str, err
    data := str.alloc(len)

    addrlen := 16
    received_len := builtin.syscall(SYS_recvfrom, s->fd, data->raw_ptr(), len, 0, sa_out, ^addrlen)
    if received_len < 0
        data->free()
        return 0 as ^str, error("net.UDPSocket.receive: recvfrom failed")
    data->realloc(received_len)
    return data, ok()

func net.UDPSocket.close_and_free[s: ^net.UDPSocket] : void
    io.close(s->fd)
    s->addr->free()
    (s as ptr)->free()

func net.parse_ipv4_str[ip: ^str] : i64, err
    n := 0
    digits := 0
    dots := 0
    acc := 0
    for i in 0..ip->len
        c := ip[i]
        if c->is_digit()
            n = n * 10 + (c - '0')
            digits += 1
            if digits > 3
                return 0, error("net.parse_ipv4_str: failed")
        if !c->is_digit()
            if c != '.' || digits == 0 || n > 255
                return 0, error("net.parse_ipv4_str: failed")
            acc = acc * 256 + n
            n = 0
            digits = 0
            dots += 1
    if dots != 3 || digits == 0 || n > 255
        return 0, error("net.parse_ipv4_str: failed")
    acc = acc * 256 + n
    return acc, ok()

func net.resolve[domain: ^str] : i64, err
    // if domain is already an ip, skip dns resolution
    ip, err := net.parse_ipv4_str(domain)
    if !err
        return ip, ok()

    query := net.build_dns_query(domain, DNS_TYPE_A)
    defer query->free()

    dns_server := "1.1.1.1"
    if net._dns_server as ptr != 0
        dns_server = net._dns_server
    else
        res := os.run_shell_command_with_output("grep -E '^nameserver' /etc/resolv.conf | head -n 1 | cut -d' ' -f2 | tr -d '\n'")
        defer (res as ptr)->free()
        defer res->stdout->free()
        if res->ok() && res->stdout->len > 6
            net._dns_server = res->stdout->make_copy()
            dns_server = net._dns_server

    s := try net.UDPSocket.new_client(dns_server, 53)
    defer s->close_and_free()
    s->set_timeout(2000)

    data := 0 as ^str
    attempt := 0
    sa := _stackalloc(16)
    while attempt < 5
        s->send_to(s->addr, query->raw_ptr(), query->len)
        d, err := s->receive(sa, 1024)
        if !err
            data = d
            break
        attempt += 1
    if data as ptr == 0
        return 0, error("net.resolve: no response from nameserver")

    defer data->free()
    // TODO: do actual parsing

    flags := data->read16be(2)
    rcode := flags & 0xf
    ancount := data->read16be(6)
    if rcode != 0 || ancount == 0
        return 0, error("net.resolve: DNS resolution failed")

    pos := 12 // skip header

    while data[pos] != 0
        pos += data[pos] + 1 // skip question

    pos += 5  // skip null byte, type(2), class(2)
    pos += 12 // skip name(2), type(2), class(2), ttl(4), rdlength(2)

    out := net.pack_addr(data[pos] as i64, data[pos+1] as i64, data[pos+2] as i64, data[pos+3] as i64)
    return out, ok()

func net.build_dns_query[domain_name: ^str, record_type: i64] : ^str
    name := net.encode_dns_name(domain_name)
    defer name->free()
    out := str.alloc(12 + name->len + 4)

    // header
    id := (os.urandom_i64() % 65536)->abs()
    out->write16be(0, id)
    out->write16be(2, DNS_RECURSION_DESIRED)
    out->write16be(4, 1)  // num_questions
    out->write16be(6, 0)  // num_answers
    out->write16be(8, 0)  // num_authorities
    out->write16be(10, 0) // num_additionals

    // question
    out->copy_from(name->raw_ptr(), 12, name->len)
    out->write16be(12 + name->len, record_type)
    out->write16be(12 + name->len + 2, DNS_CLASS_IN)

    return out

func net.encode_dns_name[domain: ^str] : ^str
    domain_len := domain->len
    buf := str.alloc(domain_len + 2)
    out_pos := 0
    part_start := 0
    i := 0
    while i <= domain_len
        if i == domain_len || domain[i] == '.'
            part_len := i - part_start
            buf[out_pos] = part_len as u8
            out_pos += 1
            buf->copy_from(domain->raw_ptr()@[part_start], out_pos, part_len)
            out_pos += part_len
            part_start = i + 1
        i += 1

    buf[out_pos] = 0
    return buf
