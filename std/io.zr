include "str.zr"
include "os.zr"

func ok[] : err
    return 0 as err

func error[s: cstr] : err
    return s as err

func io.panic[msg: cstr] : void
    io.print("panic: ")
    io.println(msg)
    builtin.int3()
    os.exit(1)

func io.panic_with[msg: cstr, e: err] : void
    s := _stackalloc(2048) as cstr
    s->format_into(2048, "%s: %s", msg, e)
    io.panic(s)

func io._oob_panic[len: i64, n: i64] : void
    s := _stackalloc(1024) as cstr
    s->format_into(1024, "index out of range (%d) with length %d", n, len)
    io.panic(s)

func io.printf[..] : void
    format := builtin.var_arg(0) as ptr
    arg_counter := 1
    i := 0

    while format[i]
        if format[i] == '%'
            i += 1

            if format[i] == 'd'
                io.print_i64(builtin.var_arg(arg_counter) as i64)
                arg_counter += 1
            else if format[i] == 'x'
                io.print_i64_hex(builtin.var_arg(arg_counter) as i64)
                arg_counter += 1
            else if format[i] == 's'
                io.print(builtin.var_arg(arg_counter) as cstr)
                arg_counter += 1
            else if format[i] == 'c'
                io.print_char(builtin.var_arg(arg_counter) as u8)
                arg_counter += 1
            else if format[i] == 'f'
                io.print_f64(builtin.var_arg(arg_counter) as f64)
                arg_counter += 1
            else if format[i] == '%'
                io.print_char('%')
            else if format[i] == 0
                break
            else
                io.panic("io.printf: unrecognized format")
        else
            io.print_char(format[i])
        i += 1

func io.print_n[x: ptr, len: i64] : void
    io.write(STDOUT_FILENO, x, len)

func io.print[x: cstr] : void
    io.print_n(x as ptr, x->len())

func io.println[x: cstr] : void
    n := x->len()
    if n < 4096
        // copy + syscall instead of 2 syscalls
        s := _stackalloc(4096)
        mem.copy_n(x@[0], s, n)
        s[n] = '\n'
        io.print_n(s, n+1)
    else
        io.print(x)
        io.print("\n")

func io.print_char[x: u8] : void
    io.print_n(^x, 1)

func io.print_bool[x: bool] : void
    if x
        io.print("true")
    else
        io.print("false")

func io.print_i64[x: i64] : void
    s := _stackalloc(21) as cstr
    x->to_str_buf(s)
    io.print(s)

func io.print_i64_hex[x: i64] : void
    s := _stackalloc(17) as cstr
    x->to_hex_str_buf(s)
    io.print(s)

func io.println_i64[x: i64] : void
    s := _stackalloc(21) as cstr
    x->to_str_buf(s)
    io.println(s)

func io.print_f64[x: f64] : void
    s := _stackalloc(64) as cstr
    x->to_str_buf(s)
    io.print(s)

func io.println_f64[x: f64] : void
    s := _stackalloc(64) as cstr
    x->to_str_buf(s)
    io.println(s)

func io.format_time[ns: i64] : cstr
    v := ns as f64
    a := v->abs()

    out := mem.alloc(100) as cstr
    if a >= 1000000000.0
        out->format_into(100, "%f s",  (v / 1000000000.0) as opaque)
    else if a >= 1000000.0
        out->format_into(100, "%f ms", (v / 1000000.0) as opaque)
    else if a >= 1000.0
        out->format_into(100, "%f us", (v / 1000.0) as opaque)
    else
        out->format_into(100, "%d ns", ns)
    return out

func io.read[fd: i64, buf: ptr, count: i64] : i64
    return builtin.syscall(SYS_read, fd, buf, count)

func io.write[fd: i64, buf: ptr, count: i64] : i64
    done := 0
    while done < count
        r := builtin.syscall(SYS_write, fd, buf@[done], count - done)
        if r == -EINTR
            continue
        if r < 0
            return r
        if r == 0
            break
        done = done + r
    return done

func io.read_line[] : cstr
    s, _ := io.read_line_with_eof()
    return s

func io.read_line_with_eof[] : cstr, bool
    b := new cstr.Builder
    c := 0 as u8
    while true
        n := io.read(STDIN_FILENO, ^c, 1)
        if n < 1
            if b->len == 0
                return b->build_str_and_free_inner(), true
            break
        if c == '\n'
            break
        b->append_char(c)
    return b->build_str_and_free_inner(), false

func io.read_file[path: cstr] : ^Bytes, err
    fd := try io.open_for_reading(path)

    len := builtin.syscall(SYS_lseek, fd, 0, SEEK_END)
    buf := Bytes.alloc(len)
    builtin.syscall(SYS_lseek, fd, 0, SEEK_SET)

    n := io.read(fd, buf->get_raw_unchecked_pointer(), len)
    io.close(fd)

    // TODO?
    if n != len
        buf->free()
        return 0 as ^Bytes, error("io.read_file: n != len")

    return buf, ok()

func io.write_text_file[path: cstr, content: cstr] : i64, err
    return io.write_file(path, content as ptr, content->len())

func io.write_file[path: cstr, content: ptr, len: i64] : i64, err
    fd := try io.open_with_flags_and_mode(path, O_WRONLY|O_CREAT|O_TRUNC, 644->octal_to_decimal())
    defer io.close(fd)

    n := io.write(fd, content, len)
    if n != len
        return 0, error("io.write_file: n != len")
    return n, ok()

func io.open_for_reading[path: cstr] : i64, err
    return io.open_with_flags_and_mode(path, O_RDONLY, 0)

func io.open_with_flags_and_mode[path: cstr, flags: i64, mode: i64] : i64, err
    fd := builtin.syscall(SYS_openat, AT_FDCWD, path, flags, mode)
    if fd < 0
        return 0, error("io.open_with_flags_and_mode: failed to open")
    return fd, ok()

func io.close[fd: i64] : void
    builtin.syscall(SYS_close, fd)
