include "str.zr"
include "os.zr"

func io.panic[msg: str] : void
    io.printf("PANIC: %s\n", msg)
    // for gdb backtrace
    _builtin_syscall(SYS_kill, os.getpid(), SIGABRT)
    os.exit(1)

func io.assert[cond: bool, msg: str] : void
    if !cond
        io.panic(msg)

func io.printf[..] : void
    s := _var_arg(0) as ptr
    i := 1

    while s[0]
        if s[0] == '%'
            s += 1

            if s[0] == 'd'
                io.print_i64(_var_arg(i) as i64)
                i += 1
            else if s[0] == 'x'
                io.print_i64_hex(_var_arg(i) as i64)
                i += 1
            else if s[0] == 's'
                io.print(_var_arg(i) as str)
                i += 1
            else if s[0] == 'c'
                io.print_char(_var_arg(i) as u8)
                i += 1
            else if s[0] == 'f'
                io.print_f64(_var_arg(i) as f64)
                i += 1
            else if s[0] == '%'
                io.print_char('%')
            else if s[0] == 0
                break
            else
                io.panic("io.printf: unrecognized format")
        else
            io.print_char(s[0])
        s += 1

func io.print_n[x: ptr, size: i64] : void
    _builtin_syscall(SYS_write, STDOUT_FILENO, x, size)

func io.print[x: str] : void
    io.print_n(x as ptr, x->len())

func io.println[x: str] : void
    io.print(x)
    io.print("\n")

func io.print_char[x: u8] : void
    io.print_n(^x, 1)

func io.print_bool[x: bool] : void
    if x
        io.print("true")
    else
        io.print("false")

func io.print_i64[x: i64] : void
    s := _stackalloc(21) as str
    x->to_str_buf(s)
    io.print(s)

func io.print_i64_hex[x: i64] : void
    s := _stackalloc(17) as str
    x->to_hex_str_buf(s)
    io.print(s)

func io.println_i64[x: i64] : void
    s := _stackalloc(21) as str
    x->to_str_buf(s)
    io.println(s)

func io.print_f64[x: f64] : void
    s := _stackalloc(64) as str
    x->to_str_buf(s)
    io.print(s)

func io.read_char[] : u8
    c := 0 as u8
    _builtin_syscall(SYS_read, STDIN_FILENO, ^c, 1)
    return c

func io.read_line[] : str
    b := new str.Builder
    while true
        c := io.read_char()
        if c == '\n'
            break
        b->append_char(c)
    return b->build_and_free_buffer()

func io.read_file[path: str] : Buffer, bool
    fd, ok := io.open_for_reading(path)
    if !ok
        return 0 as Buffer, false

    size := _builtin_syscall(SYS_lseek, fd, 0, SEEK_END)
    buf := Buffer.alloc(size)
    _builtin_syscall(SYS_lseek, fd, 0, SEEK_SET)

    n := _builtin_syscall(SYS_read, fd, buf->data(), size)
    io.close(fd)

    if n != size
        buf->free()
        return 0 as Buffer, false

    return buf, true

func io.write_text_file[path: str, content: str] : bool
    return io.write_binary_file(path, content as ptr, content->len())

func io.write_binary_file[path: str, content: ptr, size: i64] : bool
    fd, ok := io.open_with_flags_and_mode(path, O_WRONLY|O_CREAT|O_TRUNC, math.octal_to_decimal(644))
    if !ok
        return false

    n := _builtin_syscall(SYS_write, fd, content, size)
    io.close(fd)
    if n != size
        return false
    return true

func io.open_for_reading[path: str] : i64, bool
    return io.open_with_flags_and_mode(path, O_RDONLY, 0)

func io.open_with_flags_and_mode[path: str, flags: i64, mode: i64] : i64, bool
    fd := _builtin_syscall(SYS_openat, AT_FDCWD, path, flags, mode)
    if fd < 0
        return -1, false
    return fd, true

func io.send_file[out_fd: i64, in_fd: i64, offset: ptr, count: i64] : i64
    return _builtin_syscall(SYS_sendfile, out_fd, in_fd, offset, count)

func io.close[fd: i64] : void
    _builtin_syscall(SYS_close, fd)
