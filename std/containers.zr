include "mem.zr"

struct Result<T>
    value: T
    err: str

func Result.free<T>[r: Result<T>] : void
    (r as ptr)->free()

func Result.is_err<T>[r: Result<T>] : bool
    return r->err as bool

func Result.unpack<T>[r: Result<T>] : T, str
    v := r->value
    err := r->err
    r->free()
    return v, err

func Result.expect<T>[r: Result<T>, msg: str] : T
    if r->is_err()
        full_msg := _stackalloc(1024) as str
        full_msg->format_into(1024, "%s: %s", msg, r->err)
        io.panic(full_msg)
    v := r->value
    r->free()
    return v

func ok<T>[value: T] : Result<T>
    r := new* Result<T>
    r->value = value
    return r

func err<T>[err: str] : Result<T>
    r := new* Result<T>
    r->err = err
    return r

struct Array<T>
    data: ptr
    len: i64
    capacity: i64

func Array.preallocate_and_zero<T>[xs: Array<T>, len: i64] : void
    if len > 0
        xs->data = mem.alloc(len * 8)
        mem.zero(xs->data, len * 8)
        xs->len = len
        xs->capacity = len

    // ignore this horrible hack, codegen needs Array<opaque> for array literals
    if false
        new Array<opaque>

func Array.nth<T>[xs: Array<T>, n: i64] : T
    if n < 0 || n >= xs->len
        io.panic("Array.nth: out of bounds")
    return mem.read64(xs->data@[n * 8]) as T

func Array.set<T>[xs: Array<T>, n: i64, x: T] : void
    if n < 0 || n >= xs->len
        io.panic("Array.set: out of bounds")
    mem.write64(xs->data@[n * 8], x as i64)

func Array.push<T>[xs: Array<T>, x: T] : void
    if xs->len == xs->capacity
        new_capacity := 4
        if xs->capacity != 0
            new_capacity = xs->capacity * 2
        xs->data = xs->data->realloc(new_capacity * 8)
        xs->capacity = new_capacity

    mem.write64(xs->data@[xs->len * 8], x as i64)
    xs->len += 1

func Array.slice<T>[xs: Array<T>, start: i64, length: i64] : Array<T>
    if start < 0 || length < 0 || start + length > xs->len
        io.panic("Array.slice: out of bounds")

    new_array := [] as Array<T>
    new_array->preallocate_and_zero(length)
    mem.copy_n(xs->data@[start * 8], new_array->data, length * 8)
    return new_array

func Array.concat<T>[a: Array<T>, b: Array<T>] : Array<T>
    new_array := [] as Array<T>
    new_array->preallocate_and_zero(a->len + b->len)
    mem.copy_n(a->data, new_array->data@[0], a->len * 8)
    mem.copy_n(b->data, new_array->data@[a->len * 8], b->len * 8)
    return new_array

func Array.count<T>[xs: Array<T>, x: T] : i64
    n := 0
    for i in 0..xs->len
        if xs->nth(i) as i64 == x as i64
            n += 1
    return n

func Array.free<T>[xs: Array<T>] : void
    if xs->data != 0
        xs->data->free()
    (xs as ptr)->free()

func Array.free_with_ptr_items<T>[xs: Array<T>] : void
    if xs->data != 0
        for i in 0..xs->len
            (xs->nth(i) as ptr)->free()
        xs->data->free()
    (xs as ptr)->free()

func Array.pop<T>[xs: Array<T>] : T
    if xs->len == 0
        io.panic("Array.pop: empty array")
    x := xs->last() as T
    xs->len = xs->len - 1
    return x

func Array.last<T>[xs: Array<T>] : T
    if xs->len == 0
        io.panic("Array.last: empty array")
    return xs->nth(xs->len - 1)

func Array.contains_str[arr: Array<str>, s: str] : bool
    for i in 0..arr->len
        if arr->nth(i)->equal(s)
            return true
    return false

func Array.map<I, O>[f: funcptr<O, I>, xs: Array<I>] : Array<O>
    out := [] as Array<O>
    out->preallocate_and_zero(xs->len)
    for i in 0..xs->len
        out->set(i, f(xs->nth(i)))
    return out

func Array.reduce<I, A>[f: funcptr<A, I, A>, xs: Array<I>, acc: A] : A
    for i in 0..xs->len
        acc = f(xs->nth(i), acc)
    return acc

func Array.filter<T>[f: funcptr<bool, T>, xs: Array<T>] : Array<T>
    out := [] as Array<T>
    for i in 0..xs->len
        if f(xs->nth(i))
            out->push(xs->nth(i))
    return out

const HashMap._TABLE_SIZE = 100

struct HashMap<T>
    table: Array<HashMap._Node>

struct HashMap._Node
    key: str
    value: opaque
    next: HashMap._Node

func HashMap.new<T>[] : HashMap<T>
    hm := new* HashMap<T>
    hm->table = [] as Array<HashMap._Node>
    hm->table->preallocate_and_zero(HashMap._TABLE_SIZE)
    return hm

func HashMap._djb2[key: str] : i64
    hash := 5381
    for i in 0..key->len()
        hash = ((hash << 5) + hash) + key[i]
    hash = (hash & 0x7fffffffffffffff) // prevent negative
    return hash % HashMap._TABLE_SIZE

func HashMap.insert<T>[hm: HashMap<T>, key: str, value: T] : void
    if hm->contains(key)
        io.panic("HashMap.insert: tried to insert a duplicate key")
    index := HashMap._djb2(key)
    current := hm->table->nth(index)

    while current as ptr
        if current->key->equal(key)
            current->value = value as opaque
            return
        current = current->next

    new_node := new* HashMap._Node
    new_node->key = key->make_copy()
    new_node->value = value as opaque
    new_node->next = hm->table->nth(index)
    hm->table->set(index, new_node)

func HashMap.get<T>[hm: HashMap<T>, key: str] : T, bool
    index := HashMap._djb2(key)
    current := hm->table->nth(index)

    while current as ptr
        if current->key->equal(key)
            return current->value as T, true
        current = current->next

    return 0 as T, false

func HashMap.contains<T>[hm: HashMap<T>, key: str] : bool
    index := HashMap._djb2(key)
    current := hm->table->nth(index)

    while current as ptr
        if current->key->equal(key)
            return true
        current = current->next

    return false

func HashMap.delete<T>[hm: HashMap<T>, key: str] : void
    index := HashMap._djb2(key)
    current := hm->table->nth(index)
    prev := 0 as HashMap._Node

    while current as ptr
        if current->key->equal(key)
            if prev as ptr
                prev->next = current->next
            else
                hm->table->set(index, current->next)

            current->key->free()
            (current as ptr)->free()
            return

        prev = current
        current = current->next

func HashMap.count<T>[hm: HashMap<T>] : i64
    n := 0
    for i in 0..hm->table->len
        node := hm->table->nth(i)
        while node as ptr
            n += 1
            node = node->next
    return n

func HashMap.keys<T>[hm: HashMap<T>] : Array<str>
    out := [] as Array<str>
    for i in 0..HashMap._TABLE_SIZE
        current := hm->table->nth(i)
        while current as ptr
            out->push(current->key)
            current = current->next
    return out

func HashMap.free<T>[hm: HashMap<T>] : void
    for i in 0..HashMap._TABLE_SIZE
        current := hm->table->nth(i)
        while current as ptr
            tmp := current
            current = current->next
            tmp->key->free()
            (tmp as ptr)->free()

    hm->table->free()
    (hm as ptr)->free()
