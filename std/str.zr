include "mem.zr"

func u8.is_whitespace[x: u8] : bool
    return x == ' ' || x == '\n' || x == '\t' || x == '\r'

func u8.is_digit[x: u8] : bool
    return x >= '0' && x <= '9'

func u8.is_hex_digit[x: u8] : bool
    return (x >= '0' && x <= '9') || (x >= 'a' && x <= 'f') || (x >= 'A' && x <= 'F')

func u8.is_lowercase[x: u8] : bool
    return x >= 'a' && x <= 'z'

func u8.is_uppercase[x: u8] : bool
    return x >= 'A' && x <= 'Z'

func u8.is_letter[x: u8] : bool
    return x->is_uppercase() || x->is_lowercase()

func u8.is_alphanumeric[x: u8] : bool
    return x->is_letter() || x->is_digit()

func u8.to_str[c: u8] : cstr
    s := mem.alloc(2) as cstr
    s[0] = c
    s[1] = 0
    return s

struct str
    data: ptr
    len: i64

func str.alloc[len: i64] : ^str
    s := new* str
    s->data = mem.alloc(len)
    s->len = len
    return s

func str.from_cstr[c: cstr] : ^str
    c_len := c->len()
    s := str.alloc(c_len)
    mem.copy_n(c@[0], s->raw_ptr(), c_len)
    return s

func str.from_parts[data: ptr, len: i64] : ^str
    s := new* str
    s->data = data
    s->len = len
    return s

func str.cast_from_bytes[b: ^Bytes] : ^str
    return b as ^str

func str.to_cstr[s: ^str, c: cstr, max_len: i64] : void
    n := math.min(s->len, max_len-1)
    mem.copy_n(s->raw_ptr(), c@[0], n)
    c[n] = 0

func str.raw_ptr[s: ^str] : ptr
    return s->data

func str.free[s: ^str] : void
    s->data->free()
    (s as ptr)->free()

func str.concat[a: ^str, b: ^str] : ^str
    out := str.alloc(a->len + b->len)
    mem.copy_n(a->raw_ptr(), out->raw_ptr()@[0], a->len)
    mem.copy_n(b->raw_ptr(), out->raw_ptr()@[a->len], b->len)
    return out

func str.substr_n[s: ^str, start: i64, length: i64] : ^str
    out := str.alloc(length)
    mem.copy_n(s->raw_ptr()@[start], out->raw_ptr()@[0], length)
    return out

func str.equal[a: ^str, b: ^str] : bool
    if a->len != b->len
        return false
    i := 0
    while i < a->len
        if a[i] != b[i]
            return false
        i += 1
    return true

func str.make_copy[s: ^str] : ^str
    out := str.alloc(s->len)
    mem.copy_n(s->raw_ptr(), out->raw_ptr(), s->len)
    return out

func str.find[haystack: ^str, needle: ^str, start: i64] : i64
    if needle->len == 0
        return 0

    if needle->len > haystack->len
        return -1

    for i in (start)..=(haystack->len - needle->len)
        if haystack[i] != needle[0]
            continue
        if needle->len == 1
            return i
        match := true
        for j in 1..needle->len
            if haystack[i + j] != needle[j]
                match = false
                break
        if match
            return i
    return -1

func cstr.free[s: cstr] : void
    (s as ptr)->free()

func cstr.len[s: cstr] : i64
    if s as ptr == 0
        io.panic("cstr.len: called on a null pointer")
    i := 0
    while s[i]
        i += 1
    return i

func cstr.make_copy[s: cstr] : cstr
    len := s->len() + 1
    dup := mem.alloc(len) as cstr
    mem.copy_n(s as ptr, dup as ptr, len)
    return dup

func cstr.equal[a: cstr, b: cstr] : bool
    i := 0
    while a[i] != 0 && b[i] != 0
        if a[i] != b[i]
            return false
        i += 1
    return a[i] == b[i]

func cstr.equal_n[a: cstr, b: cstr, n: i64] : bool
    i := 0
    while i < n
        if a[i] == 0 || b[i] == 0
            return false
        if a[i] != b[i]
            return false
        i += 1
    return true

func cstr.format_into[..] : void
    target_buf := builtin.var_arg(0) as cstr
    max_len := builtin.var_arg(1) as i64
    if max_len <= 0
        return
    format := builtin.var_arg(2) as ^str
    i := 0
    arg_counter := 3
    written := 0

    tmp := _stackalloc(64) as cstr

    while i < format->len
        remaining := max_len - written - 1
        if remaining <= 0
            break

        if format[i] == '%'
            i += 1
            if format[i] == 'd'
                tmp_len := (builtin.var_arg(arg_counter) as i64)->to_str_buf(tmp)
                mem.copy_n(tmp@[0], target_buf@[written], math.min(tmp_len, remaining))
                written += math.min(tmp_len, remaining)
                arg_counter += 1
            else if format[i] == 'x'
                tmp_len := (builtin.var_arg(arg_counter) as i64)->to_hex_str_buf(tmp)
                mem.copy_n(tmp@[0], target_buf@[written], math.min(tmp_len, remaining))
                written += math.min(tmp_len, remaining)
                arg_counter += 1
            else if format[i] == 's'
                s := builtin.var_arg(arg_counter) as ^str
                mem.copy_n(s->raw_ptr(), target_buf@[written], math.min(s->len, remaining))
                written += math.min(s->len, remaining)
                arg_counter += 1
            else if format[i] == 'c'
                target_buf[written] = builtin.var_arg(arg_counter) as u8
                written += 1
                arg_counter += 1
            else if format[i] == 'f'
                tmp_len := (builtin.var_arg(arg_counter) as f64)->to_str_buf(tmp)
                mem.copy_n(tmp@[0], target_buf@[written], math.min(tmp_len, remaining))
                written += math.min(tmp_len, remaining)
                arg_counter += 1
            else if format[i] == '%'
                target_buf[written] = '%'
                written += 1
            else if format[i] == 0
                break
            else
                io.panic("str.format_into: unrecognized format")
        else
            target_buf[written] = format[i]
            written += 1
        i += 1

    target_buf[written] = 0

func cstr.starts_with[haystack: cstr, needle: cstr] : bool
    return haystack->find(needle) == 0

func cstr.find[haystack: cstr, needle: cstr] : i64
    return haystack->find_n(haystack->len(), needle, needle->len())

func cstr.find_n[haystack: cstr, haystack_len: i64, needle: cstr, needle_len: i64] : i64
    if needle_len == 0
        return 0

    if needle_len > haystack_len
        return -1

    for i in 0..=(haystack_len - needle_len)
        if haystack[i] != needle[0]
            continue
        if needle_len == 1
            return i
        match := true
        for j in 1..needle_len
            if haystack[i + j] != needle[j]
                match = false
                break
        if match
            return i
    return -1

func cstr.substr_n[s: cstr, start: i64, length: i64] : cstr
    out := mem.alloc(length + 1) as cstr
    mem.copy_n(s@[start], out@[0], length)
    out[length] = 0
    return out

func str.trim[s: ^str] : ^str
    if s->len == 0
        return str.from_parts(0 as ptr, 0)

    start := 0
    end := s->len - 1

    while start <= end && s[start]->is_whitespace()
        start += 1

    while end >= start && s[end]->is_whitespace()
        end -= 1

    return s->substr_n(start, end - start + 1)

func str.reverse[s: ^str] : ^str
    out := str.alloc(s->len)

    for i in 0..s->len
        out[i] = s[s->len - i - 1]
    return out

func str.split[haystack: ^str, needle: ^str]: ^Array<^str>
    result := [] as ^Array<^str>

    if !needle->len
        if !haystack->len
            return result
        else
            for i in 0..haystack->len
                result->push(haystack->substr_n(i, 1))
            return result

    start := 0
    i := 0
    while i < haystack->len
        if i <= haystack->len - needle->len
            match := true
            for j in 0..needle->len
                if haystack[i + j] != needle[j]
                    match = false
                    break
            if match
                result->push(haystack->substr_n(start, i - start))
                start = i + needle->len
                i += needle->len
                continue
        i += 1

    result->push(haystack->substr_n(start, haystack->len - start))
    return result

func str.to_lower[s: ^str] : ^str
    out := s->make_copy()
    i := 0
    while out[i]
        if 'A' <= out[i] && out[i] <= 'Z'
            out[i] += 32
        i += 1
    return out

func str.to_upper[s: ^str] : ^str
    out := s->make_copy()
    i := 0
    while out[i]
        if 'a' <= out[i] && out[i] <= 'z'
            out[i] -= 32
        i += 1
    return out

func str.parse_i64[s: ^str] : i64, err
    i := 0

    sign := 1
    if i < s->len && s[i] == '-'
        sign = -1
        i += 1

    if i == s->len
        return 0, error("str.parse_i64: failed to parse")

    num := 0
    while i < s->len
        d := s[i]
        if !d->is_digit()
            return 0, error("str.parse_i64: failed to parse")
        num = num * 10 + (d - '0')
        i += 1
    return num * sign, ok()

func str.parse_hex_i64[s: ^str] : i64
    i := 0

    sign := 1
    if i < s->len && s[i] == '-'
        sign = -1
        i += 1

    num := 0
    while i < s->len
        d := s[i]
        if !d->is_hex_digit()
            break
        num = num * 16 + u8._hex_digit_to_int(d)
        i += 1
    return num * sign

func str.parse_f64[s: ^str] : f64
    i := 0
    while i < s->len && s[i]->is_whitespace()
        i += 1

    negative := false
    if s[i] == '+' || s[i] == '-'
        negative = s[i] == '-'
        i += 1

    has_digits := false
    mantissa := 0.0

    while i < s->len && s[i]->is_digit()
        mantissa = mantissa * 10.0 + (s[i] - '0') as i64 as f64
        i += 1
        has_digits = true

    if i < s->len && s[i] == '.'
        i += 1
        frac_scale := 0.1
        while i < s->len && s[i]->is_digit()
            mantissa = mantissa + ((s[i] - '0') as i64 as f64 * frac_scale)
            frac_scale = frac_scale * 0.1
            i += 1
            has_digits = true

    if !has_digits
        io.panic("str.parse_f64: number must contain digits")

    if negative
        return -mantissa
    return mantissa

func str.hex_encode[s: ptr, len_in_bytes: i64] : ^str
    hex_chars := "0123456789abcdef"
    out := str.alloc(len_in_bytes * 2 + 1)

    for i in 0..len_in_bytes
        b := s[i]
        out[i * 2]     = hex_chars[(b >> 4) & 15]
        out[i * 2 + 1] = hex_chars[b & 15]

    return out

func u8._hex_digit_to_int[d: u8] : u8
    if d->is_digit()
        return d - '0'
    lower := d | 32
    if lower >= 'a' && lower <= 'f'
        return lower - 'a' + 10
    io.panic("str._hex_digit_to_int: invalid hex digit")

func str.hex_decode[s: ^str] : ^Bytes
    if s->len % 2 != 0
        io.panic("str.hex_decode: invalid hex string")

    out_len := s->len / 2
    out := Bytes.alloc(out_len)

    for i in 0..out_len
        high := u8._hex_digit_to_int(s[i * 2])
        low := u8._hex_digit_to_int(s[i * 2 + 1])
        out[i] = (high << 4) | low

    return out

struct str.Builder
    data: ptr
    len: i64
    capacity: i64

func str.Builder.append_char[b: ^str.Builder, c: u8] : void
    b->_maybe_grow(1)
    b->data[b->len] = c
    b->len += 1

func str.Builder.append[b: ^str.Builder, s: ^str] : void
    b->append_n(s->raw_ptr(), s->len)

func str.Builder.append_n[b: ^str.Builder, s: ptr, len: i64] : void
    b->_maybe_grow(len)
    mem.copy_n(s, b->data@[b->len], len)
    b->len += len

func str.Builder.manual_n[b: ^str.Builder, len: i64] : ptr
    b->_maybe_grow(len)
    p := b->data@[b->len]
    b->advance(len)
    return p

func str.Builder.advance[b: ^str.Builder, n: i64] : void
    b->len += n

func str.Builder.build_str_and_free_inner[b: ^str.Builder] : ^str
    s := str.alloc(b->len)
    mem.copy_n(b->data, s->raw_ptr(), b->len)
    b->free_inner()
    return s

func str.Builder.build_bytes_and_free_inner[b: ^str.Builder] : ^Bytes
    s := Bytes.alloc(b->len)
    s->copy_into(b->data, 0, b->len)
    b->free_inner()
    return s

func str.Builder.free_inner[b: ^str.Builder] : void
    if b->data != 0
        b->data->free()
        b->data = 0 as ptr
    b->len = 0
    b->capacity = 0

func str.Builder._maybe_grow[b: ^str.Builder, needed: i64] : void
    if b->len + needed > b->capacity
        new_capacity := 64
        if b->capacity != 0
            new_capacity = b->capacity * 2
        while new_capacity < b->len + needed
            new_capacity = new_capacity * 2
        b->data = b->data->realloc(new_capacity)
        b->capacity = new_capacity
