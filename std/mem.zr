include "linux_syscalls.zr"
include "num.zr"

struct mem.Allocator
    alloc_func: funcptr<ptr, mem.Allocator, i64>
    free_func: funcptr<void, mem.Allocator, ptr>
    realloc_func: funcptr<ptr, mem.Allocator, ptr, i64>

var mem.allocator: mem.Allocator
var mem._lock: i64

func mem.alloc[len: i64] : ptr
    _builtin_lock(^mem._lock)
    defer
        mem._lock = 0
    mem._ensure_allocator()
    return (mem.allocator->alloc_func)(mem.allocator, len)

func ptr.free[x: ptr] : void
    _builtin_lock(^mem._lock)
    defer
        mem._lock = 0
    mem._ensure_allocator()
    (mem.allocator->free_func)(mem.allocator, x)

func ptr.realloc[x: ptr, new_len: i64] : ptr
    _builtin_lock(^mem._lock)
    defer
        mem._lock = 0
    mem._ensure_allocator()
    return (mem.allocator->realloc_func)(mem.allocator, x, new_len)

func mem._ensure_allocator[] : void
    if mem.allocator as ptr == 0
        a := _builtin_syscall(SYS_mmap, 0, 1024, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0) as mem.Allocator
        a->alloc_func = ^mem.FreeListAllocator.alloc
        a->free_func = ^mem.FreeListAllocator.free
        a->realloc_func = ^mem.FreeListAllocator.realloc
        mem.allocator = a

struct mem.FreeListAllocator
    alloc_func: funcptr<ptr, mem.Allocator, i64>
    free_func: funcptr<void, mem.Allocator, ptr>
    realloc_func: funcptr<ptr, mem.Allocator, ptr, i64>
    head: mem.FreeListBlock
    tail: mem.FreeListBlock
    rover: mem.FreeListBlock
    bins: ptr

struct mem.FreeListBlock
    len: i64
    free: bool
    next: mem.FreeListBlock
    prev: mem.FreeListBlock

const mem.FreeListBlock.LEN = 32

func mem.align[x: i64] : i64
    return (x + 7) & -8

func mem.FreeListBlock._split[blk: mem.FreeListBlock, fla: mem.FreeListAllocator, needed: i64] : void
    if blk->len >= needed + mem.FreeListBlock.LEN + 8
        new_blk := (blk as ptr)@[mem.FreeListBlock.LEN + needed] as mem.FreeListBlock
        new_blk->len = blk->len - needed - mem.FreeListBlock.LEN
        new_blk->free = true
        new_blk->next = blk->next
        new_blk->prev = blk

        if blk->next as ptr
            blk->next->prev = new_blk
        else
            fla->tail = new_blk

        blk->len = needed
        blk->next = new_blk

func mem.FreeListAllocator._request_space[fla: mem.FreeListAllocator, len: i64] : mem.FreeListBlock
    needed := len + mem.FreeListBlock.LEN
    alloc_len := (needed + 4095) & -4096
    if alloc_len < 1048576
        alloc_len = 1048576

    blk := _builtin_syscall(SYS_mmap, 0, alloc_len, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0) as mem.FreeListBlock
    if (blk as ptr as i64) == MAP_FAILED
        io.panic("mem._request_space: failed to mmap")

    blk->len = alloc_len - mem.FreeListBlock.LEN
    blk->free = false
    blk->next = 0 as mem.FreeListBlock
    blk->prev = 0 as mem.FreeListBlock

    tail := fla->tail
    if tail as ptr
        tail->next = blk
        blk->prev = tail

    fla->tail = blk
    return blk

func mem.FreeListAllocator.alloc[a: mem.Allocator, len: i64] : ptr
    fla := a as mem.FreeListAllocator

    if len <= 0
        io.panic("mem.alloc: called with nonpositive len")

    len = mem.align(len)
    if len < 16
        len = 16

    if fla->bins == 0
        raw := fla->_request_space(65 * 8)
        raw->_split(fla, 65 * 8)
        raw->free = false
        if fla->head as ptr == 0
            fla->head = raw
        fla->bins = (raw as ptr)@[mem.FreeListBlock.LEN]
        mem.zero(fla->bins, 65 * 8)

    // separate lists for small allocations
    if len <= 1024
        c := (len + 15) / 16
        slot := fla->bins@[c*8]
        head := _read64(slot) as ptr
        if head != 0
            _write64(slot, _read64(head))
            return head

    // try to cut off a piece of an already available block
    cur := fla->rover
    if cur as ptr == 0
        cur = fla->head
    wrapped := false
    while true
        if cur as ptr == 0
            if wrapped break
            wrapped = true
            cur = fla->head
            continue
        if cur->free && cur->len >= len
            cur->_split(fla, len)
            cur->free = false
            fla->rover = cur->next
            return (cur as ptr)@[mem.FreeListBlock.LEN]
        cur = cur->next

    // otherwise request a new block
    blk := fla->_request_space(len)

    if fla->head as ptr == 0
        fla->head = blk

    blk->_split(fla, len)
    fla->rover = blk->next

    return (blk as ptr)@[mem.FreeListBlock.LEN]

// releases freed and page aligned blocks back to OS
func mem.FreeListAllocator.trim[fla: mem.FreeListAllocator] : void
    _builtin_lock(^mem._lock)
    defer
        mem._lock = 0

    fla->rover = 0 as mem.FreeListBlock
    cur := fla->tail
    while cur as ptr && cur->free
        block_total := cur->len + mem.FreeListBlock.LEN
        if (cur as i64 & 4095) != 0 || (block_total & 4095) != 0
            break

        prev := cur->prev
        if prev as ptr
            prev->next = 0 as mem.FreeListBlock
        else
            fla->head = 0 as mem.FreeListBlock

        fla->tail = prev
        _builtin_syscall(SYS_munmap, cur, block_total)

        cur = prev

// doesnt actually release memory, see trim()
func mem.FreeListAllocator.free[a: mem.Allocator, x: ptr] : void
    fla := a as mem.FreeListAllocator

    if x == 0
        return

    blk := x@[-mem.FreeListBlock.LEN] as mem.FreeListBlock
    if blk->free
        io.panic("ptr.free: double free detected")

    if blk->len <= 1024
        slot := fla->bins@[(blk->len / 16) * 8]
        _write64(x, _read64(slot))
        _write64(slot, x as i64)
        return

    blk->free = true

    // coalesce forwards
    next := blk->next
    if next as ptr && next->free
        expected_next := (blk as ptr)@[mem.FreeListBlock.LEN + blk->len] as mem.FreeListBlock
        if expected_next as ptr == next as ptr
            blk->len += mem.FreeListBlock.LEN + next->len
            blk->next = next->next
            if fla->rover as ptr == next as ptr
                fla->rover = blk
            if next->next as ptr
                next->next->prev = blk
            if fla->tail as ptr == next as ptr
                fla->tail = blk

    // coalesce backwards
    prev := blk->prev
    if prev as ptr && prev->free
        expected_blk := (prev as ptr)@[mem.FreeListBlock.LEN + prev->len] as mem.FreeListBlock
        if expected_blk as ptr == blk as ptr
            prev->len += mem.FreeListBlock.LEN + blk->len
            prev->next = blk->next
            if fla->rover as ptr == blk as ptr
                fla->rover = prev
            if blk->next as ptr
                blk->next->prev = prev
            if fla->tail as ptr == blk as ptr
                fla->tail = prev
            blk = prev

func mem.FreeListAllocator.realloc[a: mem.Allocator, x: ptr, new_len: i64] : ptr
    fla := a as mem.FreeListAllocator

    if !x
        return mem.FreeListAllocator.alloc(a, new_len)

    if new_len <= 0
        io.panic("ptr.realloc: called with nonpositive len")

    new_len = mem.align(new_len)

    blk := x@[-mem.FreeListBlock.LEN] as mem.FreeListBlock
    if blk->len >= new_len
        blk->_split(fla, new_len)
        return x

    next := blk->next
    expected_next := (blk as ptr)@[mem.FreeListBlock.LEN + blk->len] as mem.FreeListBlock

    // try to resize in place
    if next as ptr && next->free && expected_next as ptr == next as ptr
        combined := blk->len + mem.FreeListBlock.LEN + next->len
        if combined >= new_len
            blk->len = combined
            blk->next = next->next
            if fla->rover as ptr == next as ptr
                fla->rover = blk
            if next->next as ptr
                next->next->prev = blk
            if fla->tail as ptr == next as ptr
                fla->tail = blk
            blk->_split(fla, new_len)
            return x

    // otherwise allocate a new buffer and copy
    new_ptr := mem.FreeListAllocator.alloc(a, new_len)
    mem.copy_n(x, new_ptr, math.min(blk->len, new_len))
    mem.FreeListAllocator.free(a, x)
    return new_ptr

func ptr.zero_and_free[x: ptr, len: i64] : void
    mem.zero(x, len)
    x->free()

func mem.zero[x: ptr, len: i64] : void
    i := 0
    while i + 8 <= len
        _write64(x@[i], 0)
        i += 8
    while i < len
        x[i] = 0 as u8
        i += 1

func ptr.find[x: ptr, needle: u8, max_offset: i64] : i64
    for i in 0..max_offset
        if x[i] == needle
            return i
    return -1

func mem.copy_n[src: ptr, dst: ptr, n: i64] : void
    if n < 0
        io.panic("mem.copy_n: negative length")
    if !src
        io.panic("mem.copy_n: null src pointer")
    if !dst
        io.panic("mem.copy_n: null dst pointer")

    if n == 0
        return

    if dst as i64 > src as i64 && dst as i64 < src@[n] as i64
        i := n
        while i - 8 >= 0
            i -= 8
            _write64(dst@[i], _read64(src@[i]))
        while i > 0
            i -= 1
            dst[i] = src[i]
    else
        i := 0
        while i + 8 <= n
            _write64(dst@[i], _read64(src@[i]))
            i += 8
        while i < n
            dst[i] = src[i]
            i += 1

func mem.read16[x: ptr] : i64
    return x[0] as i64 | (x[1] << 8)

func mem.read16be[x: ptr] : i64
    return (x[0] << 8) as i64 | x[1]

func mem.read32[x: ptr] : i64
    return x[0] as i64 | (x[1] << 8) | (x[2] << 16) | (x[3] << 24)

func mem.read32be[x: ptr] : i64
    return (x[0] as i64 << 24) | (x[1] << 16) | (x[2] << 8) | x[3]

func mem.read64[x: ptr] : i64
    return _read64(x)

func mem.read64be[x: ptr] : i64
    return (mem.read32be(x) << 32) | mem.read32be(x@[4])

func mem.write16[x: ptr, d: i64] : void
    x[0] = d & 0xff
    x[1] = (d >> 8) & 0xff

func mem.write16be[x: ptr, d: i64] : void
    x[0] = (d >> 8) & 0xff
    x[1] = d & 0xff

func mem.write32[x: ptr, d: i64] : void
    x[0] = d & 0xff
    x[1] = (d >> 8) & 0xff
    x[2] = (d >> 16) & 0xff
    x[3] = (d >> 24) & 0xff

func mem.write32be[x: ptr, d: i64] : void
    x[0] = (d >> 24) & 0xff
    x[1] = (d >> 16) & 0xff
    x[2] = (d >> 8) & 0xff
    x[3] = d & 0xff

func mem.write64[x: ptr, d: i64] : void
    _write64(x, d)

func mem.write64be[x: ptr, d: i64] : void
    mem.write32be(x, d >> 32)
    mem.write32be(x@[4], d)

// sneaky length-prefixed buffer
struct Buffer
    len: i64

func Buffer.alloc[n: i64] : Buffer
    out := mem.alloc(8 + n) as Buffer
    out->len = n
    return out

func Buffer.from_str[s: str] : Buffer
    out := Buffer.alloc(s->len())
    mem.copy_n(s@[0], out@[0], out->len)
    return out

func Buffer.alloc_zeroed[n: i64] : Buffer
    out := Buffer.alloc(n)
    if n > 0
        mem.zero(out@[0], n)
    return out

func Buffer.realloc[b: Buffer, new_len: i64] : Buffer
    new_b := (b as ptr)->realloc(8 + new_len) as Buffer
    new_b->len = new_len
    return new_b

func Buffer.free[b: Buffer] : void
    (b as ptr)->free()
