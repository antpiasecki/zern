include "linux_syscalls.zr"
include "num.zr"

const mem.Block.SIZE = 32

var mem._heap_head
var mem._heap_tail

struct mem.Block
    size: i64
    free: bool
    next: mem.Block
    prev: mem.Block

func mem.align[x: i64] : i64
    return (x + 7) & -8

func mem.Block._split[blk: mem.Block, needed: i64] : void
    if blk->size >= needed + mem.Block.SIZE + 8
        new_blk := (blk as ptr + mem.Block.SIZE + needed) as mem.Block
        new_blk->size = blk->size - needed - mem.Block.SIZE
        new_blk->free = true
        new_blk->next = blk->next
        new_blk->prev = blk

        if blk->next as ptr
            blk->next->prev = new_blk
        else
            mem._heap_tail = new_blk as ptr as i64

        blk->size = needed
        blk->next = new_blk

func mem._request_space[size: i64] : mem.Block
    needed := size + mem.Block.SIZE
    alloc_size := (needed + 4095) & -4096

    blk := _builtin_syscall(SYS_mmap, 0, alloc_size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0) as mem.Block
    if (blk as ptr as i64) == MAP_FAILED
        io.panic("mem._request_space: failed to mmap")

    blk->size = alloc_size - mem.Block.SIZE
    blk->free = false
    blk->next = 0 as mem.Block
    blk->prev = 0 as mem.Block

    tail := mem._heap_tail as mem.Block
    if tail as ptr
        tail->next = blk
        blk->prev = tail

    mem._heap_tail = blk as ptr as i64
    return blk

func mem.alloc[size: i64] : ptr
    if size <= 0
        io.panic("mem.alloc: called with nonpositive size")

    size = mem.align(size)

    cur := mem._heap_head as mem.Block
    while cur as ptr
        if cur->free && cur->size >= size
            cur->_split(size)
            cur->free = false
            return cur as ptr + mem.Block.SIZE
        cur = cur->next

    blk := mem._request_space(size)

    if !mem._heap_head
        mem._heap_head = blk as ptr as i64

    blk->_split(size)

    return blk as ptr + mem.Block.SIZE

func mem.trim[] : void
    cur := mem._heap_tail as mem.Block
    while cur as ptr && cur->free
        block_total := cur->size + mem.Block.SIZE
        if (cur as i64 & 4095) != 0 || (block_total & 4095) != 0
            break

        prev := cur->prev
        if prev as ptr
            prev->next = 0 as mem.Block
        else
            mem._heap_head = 0

        mem._heap_tail = prev as ptr as i64
        _builtin_syscall(SYS_munmap, cur, block_total)

        cur = prev

func ptr.free[x: ptr] : void
    if x == 0
        return

    blk := (x - mem.Block.SIZE) as mem.Block
    if blk->free
        io.panic("ptr.free: double free detected")

    blk->free = true

    next := blk->next
    if next as ptr && next->free
        expected_next := (blk as ptr + mem.Block.SIZE + blk->size) as mem.Block
        if expected_next as ptr == next as ptr
            blk->size += mem.Block.SIZE + next->size
            blk->next = next->next
            if next->next as ptr
                next->next->prev = blk
            if mem._heap_tail == next as ptr
                mem._heap_tail = blk as ptr as i64

    prev := blk->prev
    if prev as ptr && prev->free
        expected_blk := (prev as ptr + mem.Block.SIZE + prev->size) as mem.Block
        if expected_blk as ptr == blk as ptr
            prev->size += mem.Block.SIZE + blk->size
            prev->next = blk->next
            if blk->next as ptr
                blk->next->prev = prev
            if mem._heap_tail == blk as ptr
                mem._heap_tail = prev as ptr as i64
            blk = prev

func ptr.realloc[x: ptr, new_size: i64] : ptr
    if !x
        return mem.alloc(new_size)

    if new_size < 0
        io.panic("mem.realloc: negative new_size")

    if new_size == 0
        x->free()
        return 0 as ptr

    new_size = mem.align(new_size)

    blk := (x - mem.Block.SIZE) as mem.Block
    if blk->size >= new_size
        blk->_split(new_size)
        return x

    next := blk->next
    expected_next := (blk as ptr + mem.Block.SIZE + blk->size) as mem.Block

    if next as ptr && next->free && expected_next as ptr == next as ptr
        combined := blk->size + mem.Block.SIZE + next->size
        if combined >= new_size
            blk->size = combined
            blk->next = next->next
            if next->next as ptr
                next->next->prev = blk
            if mem._heap_tail == next as ptr
                mem._heap_tail = blk as ptr as i64
            blk->_split(new_size)
            return x

    new_ptr := mem.alloc(new_size)

    mem.copy_n(x, new_ptr, math.min(blk->size, new_size))
    x->free()
    return new_ptr

func ptr.zero_and_free[x: ptr, size: i64] : void
    mem.zero(x, size)
    x->free()

func mem.zero[x: ptr, size: i64] : void
    i := 0
    while i + 8 <= size
        mem.write64(x + i, 0)
        i += 8
    while i < size
        x[i] = 0 as u8
        i += 1

func mem.copy_n[src: ptr, dst: ptr, n: i64] : void
    if n < 0
        io.panic("mem.copy_n: negative size")
    if n == 0
        return
    if !src
        io.panic("mem.copy_n: null src pointer")
    if !dst
        io.panic("mem.copy_n: null dst pointer")
    if dst > src && dst < src + n
        i := n
        while i - 8 >= 0
            i -= 8
            mem.write64(dst + i, mem.read64(src + i))
        while i > 0
            i -= 1
            dst[i] = src[i]
    else
        i := 0
        while i + 8 <= n
            mem.write64(dst + i, mem.read64(src + i))
            i += 8
        while i < n
            dst[i] = src[i]
            i += 1

func mem.read16[x: ptr] : i64
    return x[0] as i64 | (x[1] << 8)

func mem.read16be[x: ptr] : i64
    return (x[0] << 8) as i64 | x[1]

func mem.read32[x: ptr] : i64
    return x[0] as i64 | (x[1] << 8) | (x[2] << 16) | (x[3] << 24)

func mem.read32be[x: ptr] : i64
    return (x[0] as i64 << 24) | (x[1] << 16) | (x[2] << 8) | x[3]

func mem.read64[x: ptr] : i64
    return _builtin_read64(x)

func mem.read64be[x: ptr] : i64
    return (mem.read32be(x) << 32) | mem.read32be(x + 4)

func mem.write16[x: ptr, d: i64] : void
    x[0] = d & 0xff
    x[1] = (d >> 8) & 0xff

func mem.write16be[x: ptr, d: i64] : void
    x[0] = (d >> 8) & 0xff
    x[1] = d & 0xff

func mem.write32[x: ptr, d: i64] : void
    x[0] = d & 0xff
    x[1] = (d >> 8) & 0xff
    x[2] = (d >> 16) & 0xff
    x[3] = (d >> 24) & 0xff

func mem.write32be[x: ptr, d: i64] : void
    x[0] = (d >> 24) & 0xff
    x[1] = (d >> 16) & 0xff
    x[2] = (d >> 8) & 0xff
    x[3] = d & 0xff

func mem.write64[x: ptr, d: i64] : void
    _builtin_write64(x, d)

func mem.write64be[x: ptr, d: i64] : void
    mem.write32be(x, d >> 32)
    mem.write32be(x + 4, d)

// sneaky length-prefixed ptr
struct Buffer
    size: i64

func Buffer.alloc[n: i64] : Buffer
    out := mem.alloc(8 + n) as Buffer
    out->size = n
    return out

func Buffer.data[b: Buffer] : ptr
    return b as ptr + 8

func Buffer.realloc[b: Buffer, new_size: i64] : Buffer
    new_b := (b as ptr)->realloc(8 + new_size) as Buffer
    new_b->size = new_size
    return new_b

func Buffer.free[b: Buffer] : void
    (b as ptr)->free()
