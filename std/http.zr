include "net.zr"
include "json.zr"

func http.build_request[method: ^str, path: ^str, headers: ^HashMap<^str>, body: ^str] : ^str
    sb := new str.Builder

    sb->append(method)
    sb->append(" ")
    sb->append(path)
    sb->append(" HTTP/1.1\r\n")

    header_pairs := headers->pairs()
    defer header_pairs->free_with_ptr_items()
    for i in 0..header_pairs->len
        sb->append(header_pairs->nth(i)->a)
        sb->append(": ")
        sb->append(header_pairs->nth(i)->b)
        sb->append("\r\n")

    sb->append("\r\n")
    if body->len != 0
        sb->append_n(body->raw_ptr(), body->len)

    return sb->build_str_and_free_inner()

func http._parse_hex_i64_n[s: ptr, len: i64] : i64
    i := 0
    num := 0
    while i < len && s[i]->is_hex_digit()
        num = num * 16 + u8._hex_digit_to_int(s[i])
        i += 1
    return num

// TODO: handle malformed data
func http.decode_chunked_encoding_bs[s: ptr, len: i64] : ^str
    sb := new str.Builder

    i := 0
    while true
        length := http._parse_hex_i64_n(s@[i], len-i)
        while s[i] != '\r' || s[i+1] != '\n'
            i += 1
        i += 2
        if length == 0
            break
        sb->append_n(s@[i], length)
        i += length + 2

    return sb->build_str_and_free_inner()

struct http.Url
    schema: ^str
    host: ^str
    port: i64
    path: ^str

func http.Url.free[u: ^http.Url] : void
    u->schema->free()
    u->host->free()
    u->path->free()
    (u as ptr)->free()

func http.parse_url[url: ^str] : ^http.Url
    out := new* http.Url
    colon_pos := url->find("://", 0)

    out->schema = url->substr_n(0, colon_pos)

    path_pos := url->find("/", colon_pos+3)
    if path_pos != -1
        out->path = url->substr_n(colon_pos+3+path_pos, url->len-(colon_pos+3+path_pos))
        // TODO
        query_pos := out->path->find("?", 0)
        if query_pos != -1
            out->path[query_pos] = 0
        out->host = url->substr_n(colon_pos+3, path_pos)
    else
        out->path = "/"->make_copy()
        out->host = url->substr_n(colon_pos+3, url->len-(colon_pos+3))

    out->port = 80
    port_pos := out->host->find(":", 0)
    if port_pos != -1
        host_without_port := out->host->substr_n(0, port_pos)
        port_str := out->host->substr_n(port_pos+1, out->host->len-(port_pos+1))
        defer port_str->free()
        port, err := port_str->parse_i64()
        if err io.panic("invalid number")
        out->port = port
        out->host->free()
        out->host = host_without_port

    return out

func http.do_request[method: ^str, url: ^str, headers: ^HashMap<^str>, body: ^str] : ^str, err
    parsed_url := http.parse_url(url)
    defer parsed_url->free()

    if !parsed_url->schema->equal("http")
        return 0 as ^str, error("only http schema is supported")

    headers->insert("Host", parsed_url->host)
    headers->insert("Accept-Encoding", "identity")
    headers->insert("Connection", "close")
    headers->insert("User-Agent", "http.zr/1.0")

    b := http.build_request(method, parsed_url->path, headers, body)
    defer b->free()

    c := try net.connect(parsed_url->host, parsed_url->port)
    defer net.close(c)
    net.send(c, b->raw_ptr(), b->len)

    buffer_len := 100000
    buffer := mem.alloc(buffer_len)
    defer buffer->free()
    total := 0
    while true
        n := io.read(c, buffer@[total], buffer_len - total)
        if n <= 0
            break
        total += n
        if total == buffer_len
            buffer_len = buffer_len * 2
            buffer = buffer->realloc(buffer_len)
    buffer[total] = 0

    pos := 0
    for i in 0..total
        if buffer[pos] == '\r' && buffer[pos+1] == '\n' && buffer[pos+2] == '\r' && buffer[pos+3] == '\n'
            break
        pos += 1
    pos += 4

    if mem.find(buffer, total, c"Transfer-Encoding: chunked" as ptr, 26) != -1
        return http.decode_chunked_encoding_bs(buffer@[pos], total - pos), ok()
    else
        out := str.alloc(total - pos)
        out->copy_from(buffer@[pos], 0, total - pos)
        return out, ok()

func http.get[url: ^str] : ^str, err
    headers := HashMap.new::<^str>()
    defer headers->free()
    body := str.alloc_zeroed(1)
    defer body->free()
    return http.do_request("GET", url, headers, body)

func http.post[url: ^str, content_type: ^str, body: ^str] : ^str, err
    headers := HashMap.new::<^str>()
    headers->insert("Content-Type", content_type)
    defer headers->free()
    return http.do_request("POST", url, headers, body)

struct http.Req
    remote_addr: ^str
    method: ^str
    path: ^str
    headers: ^HashMap<^str>
    body: ^str

struct http.Resp
    status: i64
    headers: ^HashMap<^str>
    body: ^str

func http.Resp.string[w: ^http.Resp, status: i64, body: ^str] : void
    w->status = status
    w->body = body

func http.Resp.json[w: ^http.Resp, status: i64, value: ^json.Value] : void
    w->status = status
    body := value->dump()
    defer body->free()
    w->headers->insert("Content-Type", "application/json")
    w->body = body

func http.Resp.error[w: ^http.Resp, status: i64] : void
    w->status = status
    status_text := http.status_code_to_text(status)
    defer status_text->free()

    b := new str.Builder
    b->append_i64(status)
    b->append_char(' ')
    b->append(status_text)
    b->append_char('\n')
    w->body = b->build_str_and_free_inner()

func http.Resp.send[w: ^http.Resp, c: i64] : void
    b := w->build()
    defer b->free()
    net.send(c, b->raw_ptr(), b->len)

func http.Resp.build[w: ^http.Resp] : ^str
    sb := new str.Builder

    status_text := http.status_code_to_text(w->status)
    defer status_text->free()

    sb->append("HTTP/1.1 ")
    sb->append_i64(w->status)
    sb->append(" ")
    sb->append(status_text)
    sb->append("\r\n")

    sb->append("Content-Length: ")
    if w->body as ptr
        sb->append_i64(w->body->len)
    else
        sb->append_i64(0)
    sb->append("\r\n")

    if w->headers as ptr != 0
        header_pairs := w->headers->pairs()
        defer header_pairs->free_with_ptr_items()
        for i in 0..header_pairs->len
            sb->append(header_pairs->nth(i)->a)
            sb->append(": ")
            sb->append(header_pairs->nth(i)->b)
            sb->append("\r\n")

    sb->append("\r\n")
    if w->body as ptr && w->body->len != 0
        sb->append_n(w->body->raw_ptr(), w->body->len)

    return sb->build_str_and_free_inner()

struct http._ConnData
    c: i64
    addr: ptr
    handler: funcptr<void, ^http.Req, ^http.Resp>

func http.start_server[host: ^str, port: i64, handler: funcptr<void, ^http.Req, ^http.Resp>] : void
    s, err := net.listen(host, port)
    if err io.panic_with("failed to listen", err)

    while true
        cd := new* http._ConnData
        cd->addr = mem.alloc(16)
        cd->c = net.accept(s, cd->addr)
        if cd->c < 0
            cd->addr->free()
            (cd as ptr)->free()
            io.println("ERROR: failed to accept connection")
            continue

        cd->handler = handler
        os.spawn_thread::<^http._ConnData>(^http._handle_conn, cd)

func http._handle_conn[cd: ^http._ConnData] : void
    defer (cd as ptr)->free()
    defer cd->addr->free()
    defer net.close(cd->c)

    req := new http.Req
    defer req->remote_addr->free()
    defer req->headers->free()
    defer req->body->free()
    req->remote_addr = "%d.%d.%d.%d"->format(cd->addr[4], cd->addr[5], cd->addr[6], cd->addr[7])

    resp := new http.Resp
    resp->status = 200
    resp->headers = HashMap.new::<^str>()
    resp->body = 0 as ^str
    defer resp->headers->free()
    defer resp->body->free()

    raw_req := mem.alloc(IP_MAXPACKET)
    defer raw_req->free()
    n := io.read(cd->c, raw_req, IP_MAXPACKET)
    if n < 18 // smallest valid HTTP/1.0 request
        resp->error(400)
        resp->send(cd->c)
        return

    end_of_first_line := raw_req->find(' ', n)
    if end_of_first_line == -1
        resp->error(400)
        resp->send(cd->c)
        return
    raw_req[end_of_first_line] = 0

    path_start := end_of_first_line + 1
    end_of_path := raw_req@[path_start]->find(' ', n - path_start)
    if end_of_path == -1
        if n - path_start > 2048
            resp->error(414)
        else
            resp->error(400)
        resp->send(cd->c)
        return
    if end_of_path > 2048
        resp->error(414)
        resp->send(cd->c)
        return

    raw_req[path_start + end_of_path] = 0

    req->method = str.from_cstr(raw_req@[0] as cstr)
    req->path = str.from_cstr(raw_req@[path_start] as cstr)

    query_pos := mem.find(req->path->raw_ptr(), req->path->len, c"?" as ptr, 1)
    if query_pos != -1
        req->path->len = query_pos

    // TODO: parse req->headers

    header_end := mem.find(raw_req, n, c"\r\n\r\n" as ptr, 4)
    if header_end == -1
        resp->error(400)
        resp->send(cd->c)
        return
    body_pos := header_end + 4
    req->body = str.alloc(n - body_pos)
    if n - body_pos > 0
        req->body->copy_from(raw_req@[body_pos], 0, n - body_pos)

    (cd->handler)(req, resp)

    resp_buf := resp->build()
    defer resp_buf->free()
    net.send(cd->c, resp_buf->raw_ptr(), resp_buf->len)

func http.status_code_to_text[code: i64] : ^str
    s := "100Continue\n101Switching Protocols\n102Processing\n103Early Hints\n200OK\n201Created\n202Accepted\n203Non-Authoritative Information\n204No Content\n205Reset Content\n206Partial Content\n207Multi-Status\n208Already Reported\n226IM Used\n300Multiple Choices\n301Moved Permanently\n302Found\n303See Other\n304Not Modified\n305Use Proxy\n306Switch Proxy\n307Temporary Redirect\n308Permanent Redirect\n400Bad Request\n401Unauthorized\n402Payment Required\n403Forbidden\n404Not Found\n405Method Not Allowed\n406Not Acceptable\n407Proxy Authentication Required\n408Request Timeout\n409Conflict\n410Gone\n411Length Required\n412Precondition Failed\n413Content Too Large\n414URI Too Long\n415Unsupported Media Type\n416Range Not Satisfiable\n417Expectation Failed\n418I'm a teapot\n421Misdirected Request\n422Unprocessable Content\n423Locked\n424Failed Dependency\n425Too Early\n426Upgrade Required\n428Precondition Required\n429Too Many Requests\n431Request Header Fields Too Large\n451Unavailable For Legal Reasons\n500Internal Server Error\n501Not Implemented\n502Bad Gateway\n503Service Unavailable\n504Gateway Timeout\n505HTTP Version Not Supported\n506Variant Also Negotiates\n507Insufficient Storage\n508Loop Detected\n510Not Extended\n511Network Authentication Required\n"
    i := 0
    while i < s->len
        n := (s[i] - '0') * 100 + (s[i+1] - '0') * 10 + (s[i+2] - '0')
        i += 3
        start := i
        while i < s->len && s[i] != '\n'
            i += 1
        if code == n
            return s->substr_n(start, i-start)
        i += 1
    return ""->make_copy()
