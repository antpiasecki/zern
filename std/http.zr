include "net.zr"
include "json.zr"

func http.build_request[method: str, path: str, headers: HashMap<str>, body: Buffer] : Buffer
    sb := new str.Builder

    first_line := _stackalloc(256) as str
    first_line->format_into(256, "GET %s HTTP/1.1\r\n", path)
    sb->append(first_line)

    header_pairs := headers->pairs()
    defer header_pairs->free_with_ptr_items()
    for i in 0..header_pairs->len
        header_line := _stackalloc(512) as str
        header_line->format_into(512, "%s: %s\r\n", header_pairs->nth(i)->a, header_pairs->nth(i)->b)
        sb->append(header_line)

    sb->append("\r\n")
    if body->len != 0
        sb->append_n(body@[0], body->len)

    return sb->build_buffer_and_free_inner()

// TODO: handle malformed data
func http.decode_chunked_encoding_bs[s: ptr] : Buffer
    sb := new str.Builder

    i := 0
    while true
        length := (s@[i] as str)->parse_hex_i64()
        while s[i] != '\r' || s[i+1] != '\n'
            i += 1
        i += 2
        if length == 0
            break
        sb->append_n(s@[i], length)
        i += length + 2

    return sb->build_buffer_and_free_inner()

struct http.Url
    schema: str
    host: str
    port: i64
    path: str

func http.Url.free[u: http.Url] : void
    u->schema->free()
    u->host->free()
    u->path->free()
    (u as ptr)->free()

func http.parse_url[url: str] : http.Url
    out := new* http.Url
    colon_pos := url->find("://")

    out->schema = url->substr_n(0, colon_pos)

    path_pos := (url@[colon_pos+3] as str)->find("/")
    if path_pos != -1
        out->path = url->substr_n(colon_pos+3+path_pos, url->len()-(colon_pos+3+path_pos))
        out->host = url->substr_n(colon_pos+3, path_pos)
    else
        out->path = "/"->make_copy()
        out->host = url->substr_n(colon_pos+3, url->len()-(colon_pos+3))

    out->port = 80
    port_pos := out->host->find(":")
    if port_pos != -1
        host_without_port := out->host->substr_n(0, port_pos)
        port_str := out->host->substr_n(port_pos+1, out->host->len()-(port_pos+1))
        defer port_str->free()
        out->port = port_str->parse_i64()
        out->host->free()
        out->host = host_without_port

    return out

func http.do_request[method: str, url: str, headers: HashMap<str>, body: Buffer] : Result<Buffer>
    parsed_url := http.parse_url(url)
    defer parsed_url->free()

    if !parsed_url->schema->equal("http")
        return err::<Buffer>("only http schema is supported")

    headers->insert("Host", parsed_url->host)
    headers->insert("Accept-Encoding", "identity")
    headers->insert("Connection", "close")
    headers->insert("User-Agent", "http.zr/1.0")

    b := http.build_request(method, parsed_url->path, headers, body)
    defer b->free()

    c := try net.connect(parsed_url->host, parsed_url->port)
    defer net.close(c)
    net.send(c, b@[0], b->len)

    buffer := Buffer.alloc(100000)
    defer buffer->free()
    total := 0
    while true
        n := io.read(c, buffer@[total], buffer->len - total)
        if n <= 0
            break
        total += n
        if total == buffer->len
            buffer = buffer->realloc(buffer->len * 2)
    buffer[total] = 0

    pos := (buffer@[0] as str)->find("\r\n\r\n") + 4

    if (buffer@[0] as str)->find("Transfer-Encoding: chunked") != -1
        return ok::<Buffer>(http.decode_chunked_encoding_bs(buffer@[pos]))
    else
        out := Buffer.alloc(total)
        mem.copy_n(buffer@[pos], out@[0], total - pos)
        return ok::<Buffer>(out)

func http.get[url: str] : Result<Buffer>
    headers := HashMap.new::<str>()
    defer headers->free()
    body := Buffer.alloc(0)
    defer body->free()
    return http.do_request("GET", url, headers, body)

func http.post[url: str, content_type: str, body: Buffer] : Result<Buffer>
    headers := HashMap.new::<str>()
    headers->insert("Content-Type", content_type)
    defer headers->free()
    return http.do_request("POST", url, headers, body)

struct http.Req
    remote_addr: str
    method: str
    path: str
    headers: HashMap<str>

struct http.Resp
    status: i64
    headers: HashMap<str>
    body: Buffer

func http.Resp.string[w: http.Resp, status: i64, body: str] : void
    w->status = status
    w->body = Buffer.from_str(body)

func http.Resp.json[w: http.Resp, status: i64, value: json.Value] : void
    w->status = status
    body := value->dump()
    defer body->free()
    w->headers->insert("Content-Type", "application/json")
    w->body = Buffer.from_str(body)

func http.Resp.error[w: http.Resp, status: i64] : void
    w->status = status
    body := _stackalloc(2048) as str
    body->format_into(2048, "%d %s\n", status, http.status_code_to_text(status))
    w->body = Buffer.from_str(body)

func http.Resp.send[w: http.Resp, c: i64] : void
    b := w->build()
    defer b->free()
    net.send(c, b@[0], b->len)

func http.Resp.build[w: http.Resp] : Buffer
    sb := new str.Builder

    status_line := _stackalloc(256) as str
    status_line->format_into(256, "HTTP/1.1 %d %s\r\n", w->status, http.status_code_to_text(w->status))
    sb->append(status_line)

    content_length_line := _stackalloc(256) as str
    if w->body as ptr
        content_length_line->format_into(256, "Content-Length: %d\r\n", w->body->len)
    else
        content_length_line->format_into(256, "Content-Length: 0\r\n")
    sb->append(content_length_line)

    if w->headers as ptr != 0
        header_pairs := w->headers->pairs()
        defer header_pairs->free_with_ptr_items()
        for i in 0..header_pairs->len
            header_line := _stackalloc(512) as str
            header_line->format_into(512, "%s: %s\r\n", header_pairs->nth(i)->a, header_pairs->nth(i)->b)
            sb->append(header_line)

    sb->append("\r\n")
    if w->body as ptr && w->body->len != 0
        sb->append_n(w->body@[0], w->body->len)

    return sb->build_buffer_and_free_inner()

struct http._ConnData
    c: i64
    addr: ptr
    handler: funcptr<void, http.Req, http.Resp>

func http.start_server[host: str, port: i64, handler: funcptr<void, http.Req, http.Resp>] : void
    s := net.listen(host, port)->expect("failed to listen")

    while true
        cd := new* http._ConnData
        cd->addr = mem.alloc(16)
        cd->c = net.accept(s, cd->addr)
        if cd->c < 0
            cd->addr->free()
            (cd as ptr)->free()
            io.println("ERROR: failed to accept connection")
            continue

        cd->handler = handler
        os.spawn_thread::<http._ConnData>(^http._handle_conn, cd)

func http._handle_conn[cd: http._ConnData] : void
    defer (cd as ptr)->free()
    defer cd->addr->free()
    defer net.close(cd->c)

    req := new http.Req
    req->remote_addr = mem.alloc(30) as str
    req->remote_addr->format_into(30, "%d.%d.%d.%d", cd->addr[4], cd->addr[5], cd->addr[6], cd->addr[7])
    defer req->remote_addr->free()

    resp := new http.Resp
    resp->status = 200
    resp->headers = HashMap.new::<str>()
    resp->body = 0 as Buffer
    defer resp->headers->free()
    defer resp->body->free()

    raw_req := mem.alloc(IP_MAXPACKET)
    defer raw_req->free()
    n := io.read(cd->c, raw_req, IP_MAXPACKET)
    if n < 18 // smallest valid HTTP/1.0 request
        resp->error(400)
        resp->send(cd->c)
        return

    end_of_first_line := raw_req->find(' ', n)
    if end_of_first_line == -1
        resp->error(400)
        resp->send(cd->c)
        return
    raw_req[end_of_first_line] = 0

    end_of_path := raw_req@[end_of_first_line+1]->find(' ', n - (end_of_first_line + 1))
    if end_of_path == -1
        if n - (end_of_first_line + 1) > 2048
            resp->error(414)
        else
            resp->error(400)
        resp->send(cd->c)
        return
    if end_of_path > 2048
        resp->error(414)
        resp->send(cd->c)
        return
    raw_req[end_of_first_line + 1 + end_of_path] = 0

    req->method = raw_req@[0] as str
    req->path = raw_req@[end_of_first_line+1] as str

    // TODO: actually parse query in parse_url
    query_pos := req->path->find("?")
    if query_pos != -1
        req->path[query_pos] = 0

    // TODO: parse headers: HashMap<str>

    handler(req, resp)

    resp_buf := resp->build()
    defer resp_buf->free()
    net.send(cd->c, resp_buf@[0], resp_buf->len)

func http.status_code_to_text[code: i64] : str
  if code == 100 return "Continue"
  if code == 101 return "Switching Protocols"
  if code == 102 return "Processing"
  if code == 103 return "Early Hints"
  if code == 200 return "OK"
  if code == 201 return "Created"
  if code == 202 return "Accepted"
  if code == 203 return "Non-Authoritative Information"
  if code == 204 return "No Content"
  if code == 205 return "Reset Content"
  if code == 206 return "Partial Content"
  if code == 207 return "Multi-Status"
  if code == 208 return "Already Reported"
  if code == 226 return "IM Used"
  if code == 300 return "Multiple Choices"
  if code == 301 return "Moved Permanently"
  if code == 302 return "Found"
  if code == 303 return "See Other"
  if code == 304 return "Not Modified"
  if code == 305 return "Use Proxy"
  if code == 306 return "Switch Proxy"
  if code == 307 return "Temporary Redirect"
  if code == 308 return "Permanent Redirect"
  if code == 400 return "Bad Request"
  if code == 401 return "Unauthorized"
  if code == 402 return "Payment Required"
  if code == 403 return "Forbidden"
  if code == 404 return "Not Found"
  if code == 405 return "Method Not Allowed"
  if code == 406 return "Not Acceptable"
  if code == 407 return "Proxy Authentication Required"
  if code == 408 return "Request Timeout"
  if code == 409 return "Conflict"
  if code == 410 return "Gone"
  if code == 411 return "Length Required"
  if code == 412 return "Precondition Failed"
  if code == 413 return "Content Too Large"
  if code == 414 return "URI Too Long"
  if code == 415 return "Unsupported Media Type"
  if code == 416 return "Range Not Satisfiable"
  if code == 417 return "Expectation Failed"
  if code == 418 return "I'm a teapot"
  if code == 421 return "Misdirected Request"
  if code == 422 return "Unprocessable Content"
  if code == 423 return "Locked"
  if code == 424 return "Failed Dependency"
  if code == 425 return "Too Early"
  if code == 426 return "Upgrade Required"
  if code == 428 return "Precondition Required"
  if code == 429 return "Too Many Requests"
  if code == 431 return "Request Header Fields Too Large"
  if code == 451 return "Unavailable For Legal Reasons"
  if code == 500 return "Internal Server Error"
  if code == 501 return "Not Implemented"
  if code == 502 return "Bad Gateway"
  if code == 503 return "Service Unavailable"
  if code == 504 return "Gateway Timeout"
  if code == 505 return "HTTP Version Not Supported"
  if code == 506 return "Variant Also Negotiates"
  if code == 507 return "Insufficient Storage"
  if code == 508 return "Loop Detected"
  if code == 510 return "Not Extended"
  if code == 511 return "Network Authentication Required"
  return ""
