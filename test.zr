include "containers.zr"

func main[] : i64
    if os.file_exists("Cargo.toml")
        status := os.run_shell_command("cargo build --release")
        defer (status as ptr)->free()
        if !status->ok()
            os.exit(1)

    tr := new TestRunner
    tr->build_blacklist = [] as ^Array<cstr>
    tr->run_blacklist = ["sqlite_crud.zr", "guess_number.zr", "dns_server.zr", "chip8.zr", "crud_api.zr", "tun_tun_tun_sahur.zr", "opengl.zr"] as ^Array<cstr>
    tr->custom_build_flags = HashMap.new::<cstr>()
    tr->custom_build_flags->insert("chip8.zr", "-m dyn -L \"-lraylib\"")
    tr->custom_build_flags->insert("sqlite_crud.zr", "-m dyn -L \"-lsqlite3\"")
    tr->custom_build_flags->insert("opengl.zr", "-m dyn -L \"-lGL -lglfw\"")
    tr->custom_run_args = HashMap.new::<cstr>()
    tr->custom_run_args->insert("fetch.zr", "http://example.com")

    tr->run_directory("examples")
    io.println("DONE")

struct TestRunner
    build_blacklist: ^Array<cstr>
    run_blacklist: ^Array<cstr>
    custom_build_flags: ^HashMap<cstr>
    custom_run_args: ^HashMap<cstr>

func TestRunner.run_directory[tr: ^TestRunner, dir: cstr] : void
    files, err := os.list_directory(dir)
    if err
        io.panic("failed to open test directory")
    for i in 0..files->len
        joined := dir->concat("/")->concat(files->nth(i))
        if os.is_a_directory(joined)
            tr->run_directory(joined)
        else
            tr->run_test(joined)

func TestRunner.run_test[tr: ^TestRunner, x: cstr] : void
    io.println("------------------")
    name := os.basename(x)

    if tr->build_blacklist->contains_str(name)
        io.printf("Skipped %s\n", x)
        return

    io.printf("Building %s...\n", x)

    build_cmd := "./target/release/zern "->concat(x)
    custom_build_flags, err := tr->custom_build_flags->get(name)
    if !err
        build_cmd = build_cmd->concat(" ")->concat(custom_build_flags)

    build_start_time := os.monotonic_time_ns()
    status := os.run_shell_command(build_cmd)
    if !status->ok()
        os.exit(1)
    (status as ptr)->free()
    build_end_time := os.monotonic_time_ns()

    t := io.format_time(build_end_time - build_start_time)
    io.printf("Building %s took %s\n", x, t)
    t->free()

    if tr->run_blacklist->contains_str(name)
        io.printf("Skipped %s\n", x)
        return

    io.printf("Running %s...\n", x)

    run_cmd := "./out"
    custom_run_args, err := tr->custom_run_args->get(name)
    if !err
        run_cmd = run_cmd->concat(" ")->concat(custom_run_args)

    run_start_time := os.monotonic_time_ns()
    status = os.run_shell_command(run_cmd)
    if !status->ok()
        io.println("TEST FAILED")
        os.exit(1)
    (status as ptr)->free()
    run_end_time := os.monotonic_time_ns()

    t = io.format_time(run_end_time - run_start_time)
    io.printf("Running %s took %s\n", x, t)
    t->free()
